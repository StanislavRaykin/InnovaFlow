{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "projects": {
        "ClusterId": "projects",
        "AuthorizationPolicy": "default",
        "Match": { 
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "ideas": {
        "ClusterId": "projects",
        "AuthorizationPolicy": "default",
        "Match": { 
          "Path": "/api/ideas/{**catch-all}"
        }
      },
      "idea-drafts": {
        "ClusterId": "projects",
        "AuthorizationPolicy": "default",
        "Match": { 
          "Path": "/api/idea/drafts/{**catch-all}"
        }
      },
      "idea-versions": {
        "ClusterId": "projects",
        "AuthorizationPolicy": "default",
        "Match": { 
          "Path": "/api/idea/versions/{**catch-all}"
        }
      },
      "analyses": {
        "ClusterId": "analysis",
        "AuthorizationPolicy": "default",
        "Match": { 
          "Path": "/api/analyses/{**catch-all}"
        }
      }

    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "https+http://identity"
          }
        }
      },
      "projects": {
        "Destinations": {
          "primary": {
            "Address": "https+http://projects"
          }
        }
      },
      "analysis": {
        "Destinations": {
          "primary": {
            "Address": "https+http://analysis"
          }
        }
      }

    }
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:7060"]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "InnovaFlow.Identity",
    "Audience": "InnovaFlow"
  }
}
