{
    "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "identity-profile": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/auth/profile"
        }
      },
      "projects": {
        "ClusterId": "projects",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "ideas": {
        "ClusterId": "projects",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/ideas/{**catch-all}"
        }
      },
      "idea-drafts": {
        "ClusterId": "projects",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/idea/drafts/{**catch-all}"
        }
      },
      "idea-versions": {
        "ClusterId": "projects",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/idea/versions/{**catch-all}"
        }
      },
      "analyses": {
        "ClusterId": "analysis",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/analyses/{**catch-all}"
        }
      },
      "hubs": {
        "ClusterId": "notifier",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "https://identity.railway.internal:8080"
          }
        }
      },
      "projects": {
        "Destinations": {
          "primary": {
            "Address": "https://projects.railway.internal:8080"
          }
        }
      },
      "analysis": {
        "Destinations": {
          "primary": {
            "Address": "https://analysis.railway.internal:8080"
          }
        }
      },
      "notifier": {
        "Destinations": { "primary": { "Address": "https://notifier.railway.internal:8080" } }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": ["https://innovaflow.up.railway.app"]
  }
}
