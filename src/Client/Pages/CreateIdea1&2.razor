<aside class="hidden md:flex flex-col justify-between py-md fixed h-full left-0 w-sidebar-width bg-surface-container border-r border-primary/10 flat no shadows z-40">
<div>
<div class="px-md mb-xl">
<div class="flex items-center gap-sm mb-xs">
<span class="material-symbols-outlined text-primary text-3xl">lightbulb</span>
<span class="font-headline-md text-headline-md font-bold text-primary">InnovaFlow</span>
</div>
<div class="font-data-mono text-data-mono text-primary/70">AI OS v2.4</div>
</div>
<nav class="flex flex-col gap-xs px-sm">
<a class="flex items-center gap-sm p-sm rounded-DEFAULT text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors font-data-mono text-data-mono" href="#">
<span class="material-symbols-outlined">dashboard</span>
                    Dashboard
                </a>
<a class="flex items-center gap-sm p-sm rounded-DEFAULT text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors font-data-mono text-data-mono" href="#">
<span class="material-symbols-outlined">lightbulb</span>
                    My Ideas
                </a>
<a class="flex items-center gap-sm p-sm rounded-DEFAULT bg-primary/10 text-primary border-l-4 border-primary font-data-mono text-data-mono" href="#">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">add_circle</span>
                    Create Idea
                </a>
</nav>
</div>
<div class="px-sm">
<button class="w-full py-sm mb-md bg-primary-container text-surface font-label-caps text-label-caps font-bold rounded-DEFAULT hover:opacity-90 transition-opacity">Deploy Agent</button>
<nav class="flex flex-col gap-xs">
<a class="flex items-center gap-sm p-sm rounded-DEFAULT text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors font-data-mono text-data-mono" href="#">
<span class="material-symbols-outlined">settings</span>
                    Settings
                </a>
<a class="flex items-center gap-sm p-sm rounded-DEFAULT text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors font-data-mono text-data-mono" href="#">
<span class="material-symbols-outlined">help</span>
                    Support
                </a>
<a class="flex items-center gap-sm p-sm rounded-DEFAULT text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors font-data-mono text-data-mono" href="#">
<span class="material-symbols-outlined">logout</span>
                    Logout
                </a>
</nav>
</div>
</aside>
<!-- Main Content Area -->
<main class="flex-1 mt-16 md:mt-0 md:ml-sidebar-width flex flex-col min-h-screen">
<!-- TopAppBar -->
<header class="flex flex-col gap-sm p-md bg-surface-dim/50 backdrop-blur-xl border-b border-primary/20 shadow-lg shadow-primary/5 full-width z-30 sticky top-0 md:top-0 md:relative">
<div class="flex justify-between items-center">
<div class="flex items-center gap-sm">
<span class="material-symbols-outlined text-primary text-2xl">analytics</span>
<h1 class="font-headline-lg text-headline-lg font-bold text-primary hidden md:block">Idea Analysis</h1>
<h1 class="font-headline-lg-mobile text-headline-lg-mobile font-bold text-primary md:hidden">Idea Analysis</h1>
</div>
<div class="flex gap-sm">
<button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded-lg transition-colors">
<span class="material-symbols-outlined">refresh</span>
</button>
<button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded-lg transition-colors">
<span class="material-symbols-outlined">ios_share</span>
</button>
</div>
</div>
<!-- Progress Indicator -->
<div class="mt-sm">
<div class="flex justify-between mb-xs font-data-mono text-data-mono text-xs">
<span class="text-primary">01 Idea</span>
<span class="text-on-surface-variant">02 Problem</span>
<span class="text-on-surface-variant">03 Audience</span>
<span class="text-on-surface-variant">04 Review</span>
</div>
<div class="w-full h-1 bg-surface-container rounded-full overflow-hidden flex">
<div class="w-1/4 bg-primary h-full"></div>
<div class="w-1/4 h-full shimmer-progress"></div>
<div class="w-2/4 h-full"></div>
</div>
</div>
