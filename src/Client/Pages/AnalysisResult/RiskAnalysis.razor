@page "/risk-analysis"
@layout AccountLayout
@attribute [Authorize]


<title>Risk Analysis - SmartWear</title>

    <!-- SideNavBar (Shared Component) -->
    <nav class="hidden md:flex flex-col justify-between py-md bg-surface-container text-primary font-data-mono text-data-mono fixed h-full left-0 w-sidebar-width border-r border-primary/10 flat no shadows z-40">
        <div>
            <div class="px-md mb-xl flex items-center gap-sm">
                <span class="material-symbols-outlined text-primary text-3xl">lightbulb</span>
                <div>
                    <div class="font-headline-md text-headline-md font-bold text-primary">InnovaFlow</div>
                    <div class="text-label-caps text-on-surface-variant">AI OS v2.4</div>
                </div>
            </div>
            <div class="px-sm flex flex-col gap-xs">
                <!-- Dashboard - Inactive -->
                <a class="flex items-center gap-sm px-sm py-xs rounded text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-all" href="#">
                    <span class="material-symbols-outlined">dashboard</span>
                    Dashboard
                </a>
                <!-- My Ideas - Active (Semantic Match for Analysis) -->
                <a class="flex items-center gap-sm px-sm py-xs rounded bg-primary/10 text-primary border-l-4 border-primary hover:bg-surface-variant/50 hover:text-on-surface transition-all" href="#" style="box-shadow: -1px 0 10px rgba(107, 251, 154, 0.2);">
                    <span class="material-symbols-outlined" data-weight="fill" style="font-variation-settings: 'FILL' 1;">lightbulb</span>
                    My Ideas
                </a>
                <!-- Create Idea - Inactive -->
                <a class="flex items-center gap-sm px-sm py-xs rounded text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-all" href="#">
                    <span class="material-symbols-outlined">add_circle</span>
                    Create Idea
                </a>
            </div>
        </div>
        <div class="px-sm">
            <button class="w-full bg-primary text-on-primary font-bold py-xs rounded mb-md hover:bg-primary-fixed transition-colors flex items-center justify-center gap-xs">
                Deploy Agent
            </button>
            <div class="flex flex-col gap-xs border-t border-primary/10 pt-sm">
                <a class="flex items-center gap-sm px-sm py-xs rounded text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-all" href="#">
                    <span class="material-symbols-outlined text-[18px]">settings</span>
                    Settings
                </a>
                <a class="flex items-center gap-sm px-sm py-xs rounded text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-all" href="#">
                    <span class="material-symbols-outlined text-[18px]">help</span>
                    Support
                </a>
                <a class="flex items-center gap-sm px-sm py-xs rounded text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-all" href="#">
                    <span class="material-symbols-outlined text-[18px]">logout</span>
                    Logout
                </a>
            </div>
        </div>
    </nav>
        <!-- TopAppBar (Shared Component) -->
        <header class="flex flex-col gap-sm p-md bg-surface-dim/50 backdrop-blur-xl text-primary font-headline-lg text-headline-lg full-width border-b border-primary/20 shadow-lg shadow-primary/5 sticky top-0 z-30">
            <div class="flex justify-between items-center w-full max-w-container-max mx-auto">
                <div class="flex items-center gap-sm">
                    <span class="material-symbols-outlined text-4xl">analytics</span>
                    <h1 class="font-headline-lg text-headline-lg font-bold text-primary neon-glow">Анализ на риска</h1>
                </div>
                <div class="flex gap-sm">
                    <button class="p-xs rounded hover:bg-primary/10 text-on-surface-variant hover:text-primary transition-all relative overflow-hidden group">
                        <div class="absolute inset-0 shimmer-bg opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <span class="material-symbols-outlined relative z-10">refresh</span>
                    </button>
                    <button class="p-xs rounded hover:bg-primary/10 text-on-surface-variant hover:text-primary transition-all relative overflow-hidden group">
                        <div class="absolute inset-0 shimmer-bg opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <span class="material-symbols-outlined relative z-10">ios_share</span>
                    </button>
                </div>
            </div>
        </header>
        <!-- Content Canvas -->
        <div class="flex-1 p-md max-w-container-max mx-auto w-full flex flex-col gap-md">
            <div class="flex items-center gap-sm mb-sm">
                <span class="font-data-mono text-data-mono text-on-surface-variant">Проект:</span>
                <span class="font-headline-md text-headline-md font-bold text-on-surface">SmartWear</span>
            </div>
            <!-- Dashboard Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-md">
                <!-- Main Score Card (Span 4) -->
                <div class="glass-card rounded-lg p-sm lg:col-span-4 flex flex-col items-center justify-center text-center relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary-container via-primary to-primary-container opacity-50"></div>
                    <h2 class="font-label-caps text-label-caps text-on-surface-variant uppercase mb-sm tracking-widest">Общ Риск</h2>
                    <div class="relative w-32 h-32 flex items-center justify-center my-md">
                        <svg class="absolute inset-0 w-full h-full transform -rotate-90" viewbox="0 0 100 100">
                            <circle cx="50" cy="50" fill="none" r="45" stroke="#131b2e" stroke-width="8"></circle>
                            <circle class="transition-all duration-1000 ease-out" cx="50" cy="50" fill="none" r="45" stroke="#4ade80" stroke-dasharray="283" stroke-dashoffset="192.44" stroke-width="8"></circle> <!-- 32% of 283 -->
                        </svg>
                        <div class="flex flex-col items-center">
                            <span class="font-display-lg text-display-lg font-bold text-primary neon-glow">32</span>
                            <span class="font-data-mono text-data-mono text-on-surface-variant">/100</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-xs mt-sm">
                        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                        <span class="font-body-md text-body-md text-primary font-bold">Нисък общ риск</span>
                    </div>
                </div>
                <!-- Radar Chart Area (Span 8) -->
                <div class="glass-card rounded-lg p-sm lg:col-span-8 flex flex-col h-full">
                    <div class="flex justify-between items-center mb-md border-b border-primary/10 pb-xs">
                        <h2 class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Разпределение на Риска</h2>
                        <span class="material-symbols-outlined text-on-surface-variant text-sm">radar</span>
                    </div>
                    <div class="flex-1 relative min-h-[250px] flex items-end gap-sm pb-xl px-sm">
                        <!-- Pseudo Bar Chart for Visual representation without heavy JS -->
                        <!-- Competition -->
                        <div class="flex-1 flex flex-col items-center justify-end h-full relative group">
                            <div class="w-full max-w-[40px] bg-primary/20 border border-primary/50 rounded-t-sm relative transition-all group-hover:bg-primary/40 group-hover:border-primary" style="height: 65%;">
                                <div class="absolute top-0 left-0 w-full h-1 bg-primary"></div>
                                <span class="absolute -top-6 left-1/2 transform -translate-x-1/2 font-data-mono text-data-mono text-primary opacity-0 group-hover:opacity-100 transition-opacity">65%</span>
                            </div>
                            <span class="absolute -bottom-8 font-label-caps text-[10px] text-on-surface-variant whitespace-nowrap">Конкуренция</span>
                        </div>
                        <!-- Financial -->
                        <div class="flex-1 flex flex-col items-center justify-end h-full relative group">
                            <div class="w-full max-w-[40px] bg-tertiary/20 border border-tertiary/50 rounded-t-sm relative transition-all group-hover:bg-tertiary/40 group-hover:border-tertiary" style="height: 30%;">
                                <div class="absolute top-0 left-0 w-full h-1 bg-tertiary"></div>
                                <span class="absolute -top-6 left-1/2 transform -translate-x-1/2 font-data-mono text-data-mono text-tertiary opacity-0 group-hover:opacity-100 transition-opacity">30%</span>
                            </div>
                            <span class="absolute -bottom-8 font-label-caps text-[10px] text-on-surface-variant whitespace-nowrap">Финансов</span>
                        </div>
                        <!-- Technical -->
                        <div class="flex-1 flex flex-col items-center justify-end h-full relative group">
                            <div class="w-full max-w-[40px] bg-error/20 border border-error/50 rounded-t-sm relative transition-all group-hover:bg-error/40 group-hover:border-error" style="height: 80%;">
                                <div class="absolute top-0 left-0 w-full h-1 bg-error"></div>
                                <span class="absolute -top-6 left-1/2 transform -translate-x-1/2 font-data-mono text-data-mono text-error opacity-0 group-hover:opacity-100 transition-opacity">80%</span>
                            </div>
                            <span class="absolute -bottom-8 font-label-caps text-[10px] text-on-surface-variant whitespace-nowrap">Технически</span>
                        </div>
                        <!-- Market -->
                        <div class="flex-1 flex flex-col items-center justify-end h-full relative group">
                            <div class="w-full max-w-[40px] bg-primary/20 border border-primary/50 rounded-t-sm relative transition-all group-hover:bg-primary/40 group-hover:border-primary" style="height: 45%;">
                                <div class="absolute top-0 left-0 w-full h-1 bg-primary"></div>
                                <span class="absolute -top-6 left-1/2 transform -translate-x-1/2 font-data-mono text-data-mono text-primary opacity-0 group-hover:opacity-100 transition-opacity">45%</span>
                            </div>
                            <span class="absolute -bottom-8 font-label-caps text-[10px] text-on-surface-variant whitespace-nowrap">Пазарен</span>
                        </div>
                        <!-- Legal -->
                        <div class="flex-1 flex flex-col items-center justify-end h-full relative group">
                            <div class="w-full max-w-[40px] bg-primary/20 border border-primary/50 rounded-t-sm relative transition-all group-hover:bg-primary/40 group-hover:border-primary" style="height: 15%;">
                                <div class="absolute top-0 left-0 w-full h-1 bg-primary"></div>
                                <span class="absolute -top-6 left-1/2 transform -translate-x-1/2 font-data-mono text-data-mono text-primary opacity-0 group-hover:opacity-100 transition-opacity">15%</span>
                            </div>
                            <span class="absolute -bottom-8 font-label-caps text-[10px] text-on-surface-variant whitespace-nowrap">Правен</span>
                        </div>
                        <!-- Grid Lines -->
                        <div class="absolute left-0 bottom-xl w-full border-t border-surface-variant/50 pointer-events-none"></div>
                        <div class="absolute left-0 bottom-[calc(64px+25%)] w-full border-t border-surface-variant/30 pointer-events-none"></div>
                        <div class="absolute left-0 bottom-[calc(64px+50%)] w-full border-t border-surface-variant/30 pointer-events-none"></div>
                        <div class="absolute left-0 bottom-[calc(64px+75%)] w-full border-t border-surface-variant/30 pointer-events-none"></div>
                    </div>
                </div>
            </div>
            <!-- Risk Cards Section -->
            <div class="mt-md">
                <h3 class="font-headline-md text-headline-md font-bold text-on-surface mb-sm flex items-center gap-xs">
                    <span class="material-symbols-outlined text-primary">warning</span>
                    Детайлен Анализ на Рисковете
                </h3>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-md">
                    <!-- Risk Card 1: Technical -->
                    <div class="glass-card rounded-lg flex flex-col overflow-hidden transition-all duration-300">
                        <div class="p-sm border-b border-primary/10 flex justify-between items-start bg-error/5">
                            <div class="flex items-center gap-sm">
                                <div class="w-10 h-10 rounded-full bg-error/20 flex items-center justify-center border border-error/30 text-error">
                                    <span class="material-symbols-outlined">memory</span>
                                </div>
                                <div>
                                    <h4 class="font-headline-md text-[20px] font-bold text-on-surface">Технически Риск</h4>
                                    <span class="font-label-caps text-error">Висока Тежест</span>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="font-data-mono text-display-lg text-error">80<span class="text-body-md">%</span></div>
                                <div class="font-label-caps text-on-surface-variant">Вероятност</div>
                            </div>
                        </div>
                        <div class="p-sm flex-1 flex flex-col gap-sm">
                            <p class="font-body-md text-body-md text-on-surface-variant">
                                Проблеми с интеграцията на биометричните сензори с основния софтуер. Възможно забавяне на хардуерните доставки.
                            </p>
                            <div class="grid grid-cols-2 gap-sm mt-auto">
                                <div class="bg-surface p-xs rounded border border-surface-variant">
                                    <span class="block font-label-caps text-on-surface-variant mb-1">Въздействие</span>
                                    <span class="font-data-mono text-error">Високо</span>
                                </div>
                                <div class="bg-surface p-xs rounded border border-surface-variant">
                                    <span class="block font-label-caps text-on-surface-variant mb-1">Статус</span>
                                    <span class="font-data-mono text-tertiary">Наблюдение</span>
                                </div>
                            </div>
                        </div>
                        <div class="p-sm bg-surface-container-low border-t border-primary/10">
                            <div class="flex items-center gap-xs mb-xs">
                                <span class="material-symbols-outlined text-secondary text-sm">smart_toy</span>
                                <span class="font-label-caps text-secondary uppercase">AI Смекчаване</span>
                            </div>
                            <p class="font-body-md text-sm text-on-surface">
                                Установете паралелна разработка със симулатори на сензори. Подпишете предварителни договори с алтернативни доставчици на компоненти.
                            </p>
                        </div>
                    </div>
                    <!-- Risk Card 2: Competition -->
                    <div class="glass-card rounded-lg flex flex-col overflow-hidden transition-all duration-300">
                        <div class="p-sm border-b border-primary/10 flex justify-between items-start bg-primary/5">
                            <div class="flex items-center gap-sm">
                                <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center border border-primary/30 text-primary">
                                    <span class="material-symbols-outlined">group</span>
                                </div>
                                <div>
                                    <h4 class="font-headline-md text-[20px] font-bold text-on-surface">Конкуренция</h4>
                                    <span class="font-label-caps text-primary">Средна Тежест</span>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="font-data-mono text-display-lg text-primary">65<span class="text-body-md">%</span></div>
                                <div class="font-label-caps text-on-surface-variant">Вероятност</div>
                            </div>
                        </div>
                        <div class="p-sm flex-1 flex flex-col gap-sm">
                            <p class="font-body-md text-body-md text-on-surface-variant">
                                Големи технологични компании може да пуснат подобни продукти преди нас на по-ниска цена.
                            </p>
                            <div class="grid grid-cols-2 gap-sm mt-auto">
                                <div class="bg-surface p-xs rounded border border-surface-variant">
                                    <span class="block font-label-caps text-on-surface-variant mb-1">Въздействие</span>
                                    <span class="font-data-mono text-on-surface">Средно</span>
                                </div>
                                <div class="bg-surface p-xs rounded border border-surface-variant">
                                    <span class="block font-label-caps text-on-surface-variant mb-1">Статус</span>
                                    <span class="font-data-mono text-primary">Активен</span>
                                </div>
                            </div>
                        </div>
                        <div class="p-sm bg-surface-container-low border-t border-primary/10">
                            <div class="flex items-center gap-xs mb-xs">
                                <span class="material-symbols-outlined text-secondary text-sm">smart_toy</span>
                                <span class="font-label-caps text-secondary uppercase">AI Смекчаване</span>
                            </div>
                            <p class="font-body-md text-sm text-on-surface">
                                Фокусирайте се върху нишови функционалности, които големите играчи пренебрегват. Изградете силна общност от ранни потребители.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>