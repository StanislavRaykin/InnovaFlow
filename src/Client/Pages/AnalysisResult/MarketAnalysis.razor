@page "/analyses-result/market-analysis"
@layout AccountLayout
@attribute [Authorize]


    <!-- SideNavBar -->
    <nav class="fixed h-full left-0 w-sidebar-width border-r border-primary/10 flat no shadows bg-surface-container flex flex-col justify-between py-md z-40 hidden md:flex">
        <div>
            <div class="px-md mb-xl flex items-center gap-sm">
                <span class="material-symbols-outlined text-primary text-4xl" data-weight="fill" style="font-variation-settings: 'FILL' 1;">analytics</span>
                <div>
                    <h1 class="font-headline-md text-headline-md font-bold text-primary">InnovaFlow</h1>
                    <p class="font-data-mono text-data-mono text-on-surface-variant">AI OS v2.4</p>
                </div>
            </div>
            <ul class="flex flex-col gap-2 px-sm">
                <li>
                    <a class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface font-data-mono text-data-mono transition-colors" href="#">
                        <span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
                        Dashboard
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface font-data-mono text-data-mono transition-colors" href="#">
                        <span class="material-symbols-outlined" data-icon="lightbulb">lightbulb</span>
                        My Ideas
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface font-data-mono text-data-mono transition-colors" href="#">
                        <span class="material-symbols-outlined" data-icon="add_circle">add_circle</span>
                        Create Idea
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-md px-md py-sm rounded-lg bg-primary/10 text-primary border-l-4 border-primary font-data-mono text-data-mono transition-colors" href="#">
                        <span class="material-symbols-outlined" data-icon="query_stats">query_stats</span>
                        Пазарен Анализ
                    </a>
                </li>
            </ul>
        </div>
        <div class="px-sm">
            <button class="w-full bg-primary-container text-on-primary-container font-headline-md text-headline-md font-bold py-sm rounded-lg mb-md hover:bg-primary transition-colors flex justify-center items-center gap-2">
                Deploy Agent
            </button>
            <ul class="flex flex-col gap-2">
                <li>
                    <a class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface font-data-mono text-data-mono transition-colors" href="#">
                        <span class="material-symbols-outlined" data-icon="settings">settings</span>
                        Settings
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface font-data-mono text-data-mono transition-colors" href="#">
                        <span class="material-symbols-outlined" data-icon="help">help</span>
                        Support
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-md px-md py-sm rounded-lg text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface font-data-mono text-data-mono transition-colors" href="#">
                        <span class="material-symbols-outlined" data-icon="logout">logout</span>
                        Logout
                    </a>
                </li>
            </ul>
        </div>
    </nav>
        <!-- TopAppBar -->
        <header class="bg-surface-dim/50 backdrop-blur-xl full-width border-b border-primary/20 shadow-lg shadow-primary/5 flex flex-col gap-sm p-md sticky top-0 z-30">
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-sm">
                    <span class="material-symbols-outlined text-primary text-3xl" data-icon="analytics">analytics</span>
                    <h1 class="font-headline-lg text-headline-lg font-bold text-primary">Пазарен Анализ</h1>
                </div>
                <div class="flex items-center gap-md">
                    <span class="font-label-caps text-label-caps text-secondary-container bg-secondary-container/10 px-3 py-1 rounded-full border border-secondary-container/30 flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
                        SmartWear Analysis
                    </span>
                    <button class="p-2 rounded-lg text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors flex items-center justify-center relative overflow-hidden group">
                        <span class="material-symbols-outlined" data-icon="refresh">refresh</span>
                        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-primary/20 to-transparent -translate-x-full group-hover:animate-[shimmer_1s_infinite]"></div>
                    </button>
                    <button class="p-2 rounded-lg text-on-surface-variant hover:bg-primary/10 hover:text-primary transition-colors flex items-center justify-center relative overflow-hidden group">
                        <span class="material-symbols-outlined" data-icon="ios_share">ios_share</span>
                        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-primary/20 to-transparent -translate-x-full group-hover:animate-[shimmer_1s_infinite]"></div>
                    </button>
                </div>
            </div>
        </header>
        <!-- Canvas -->
        <div class="p-md lg:p-xl flex-1 flex flex-col gap-xl max-w-[1440px] mx-auto w-full">
            <!-- Hero / Overview Section -->
            <section class="grid grid-cols-1 lg:grid-cols-12 gap-md">
                <!-- Big Score Card -->
                <div class="lg:col-span-4 glass-card rounded-xl p-md flex flex-col justify-between relative overflow-hidden">
                    <div class="absolute -top-20 -right-20 w-64 h-64 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
                    <div>
                        <h2 class="font-label-caps text-label-caps text-on-surface-variant mb-2">Market Opportunity</h2>
                        <div class="flex items-end gap-sm">
                            <span class="font-display-lg text-display-lg text-primary">84</span>
                            <span class="font-headline-md text-headline-md text-on-surface-variant mb-2">/100</span>
                        </div>
                        <p class="font-body-md text-body-md text-on-surface mt-4">Strong potential for entry with specialized feature set.</p>
                    </div>
                    <div class="mt-xl">
                        <div class="flex justify-between font-data-mono text-data-mono text-on-surface-variant mb-2">
                            <span>Confidence Score</span>
                            <span class="text-secondary">High (92%)</span>
                        </div>
                        <div class="w-full h-1 bg-surface-container-high rounded-full overflow-hidden">
                            <div class="h-full bg-secondary w-[92%] shimmer-progress"></div>
                        </div>
                    </div>
                </div>
                <!-- Trend Line Visual (Placeholder for Data/Animation) -->
                <div class="lg:col-span-8 glass-card rounded-xl p-md flex flex-col">
                    <div class="flex justify-between items-center mb-md border-b border-primary/10 pb-sm">
                        <h2 class="font-label-caps text-label-caps text-on-surface-variant">Market Growth Trajectory</h2>
                        <span class="text-primary font-data-mono text-data-mono flex items-center gap-1">
                            <span class="material-symbols-outlined text-sm">trending_up</span> +14.2% YOY
                        </span>
                    </div>
                    <div class="flex-1 relative min-h-[200px] bg-surface-container-low/50 rounded-lg border border-surface-variant flex items-center justify-center overflow-hidden">
                        <!-- Simulated Trend Line Canvas -->
                        <div class="absolute bottom-0 left-0 w-full h-[80%] bg-gradient-to-t from-primary/10 to-transparent"></div>
                        <svg class="w-full h-full stroke-primary fill-none preserve-aspect-ratio-none absolute inset-0 drop-shadow-[0_0_8px_rgba(107,251,154,0.5)]" viewbox="0 0 100 40">
                            <path d="M0,35 Q10,32 20,28 T40,20 T60,15 T80,5 T100,2" stroke-linecap="round" stroke-width="0.5"></path>
                        </svg>
                        <div class="absolute right-4 top-4 bg-surface/80 border border-primary/30 px-3 py-2 rounded font-data-mono text-data-mono text-xs backdrop-blur-sm">
                            Proj 2025: $42B
                        </div>
                    </div>
                </div>
            </section>
            <!-- Stats Grid -->
            <section class="grid grid-cols-2 lg:grid-cols-4 gap-md">
                <div class="glass-card rounded-lg p-sm border-t-2 border-t-primary">
                    <span class="material-symbols-outlined text-primary mb-2">monitoring</span>
                    <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-1">Market Growth</h3>
                    <p class="font-headline-md text-headline-md text-on-surface">High</p>
                </div>
                <div class="glass-card rounded-lg p-sm border-t-2 border-t-tertiary">
                    <span class="material-symbols-outlined text-tertiary mb-2">swords</span>
                    <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-1">Competition</h3>
                    <p class="font-headline-md text-headline-md text-on-surface">Med-High</p>
                </div>
                <div class="glass-card rounded-lg p-sm border-t-2 border-t-secondary">
                    <span class="material-symbols-outlined text-secondary mb-2">shopping_bag</span>
                    <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-1">Demand</h3>
                    <p class="font-headline-md text-headline-md text-on-surface">High</p>
                </div>
                <div class="glass-card rounded-lg p-sm border-t-2 border-t-error">
                    <span class="material-symbols-outlined text-error mb-2">door_front</span>
                    <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-1">Entry Barrier</h3>
                    <p class="font-headline-md text-headline-md text-on-surface">Medium</p>
                </div>
            </section>
        </div>