@page "/audience-analysis"
@layout AccountLayout
@attribute [Authorize]


<title>SmartWear - Target Audience</title>


    <!-- SideNavBar (Hidden on Mobile) -->
    <nav class="hidden md:flex flex-col justify-between py-md fixed h-full left-0 w-sidebar-width border-r border-primary/10 bg-surface-container z-40">
        <div class="px-md flex flex-col gap-lg">
            <div>
                <h1 class="font-headline-md text-headline-md font-bold text-primary">InnovaFlow</h1>
                <p class="font-data-mono text-data-mono text-on-surface-variant">AI OS v2.4</p>
            </div>
            <ul class="flex flex-col gap-sm">
                <li><a class="flex items-center gap-xs px-sm py-xs text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors font-data-mono text-data-mono rounded-DEFAULT" href="#"><span class="material-symbols-outlined" data-icon="dashboard">dashboard</span> Dashboard</a></li>
                <li><a class="flex items-center gap-xs px-sm py-xs bg-primary/10 text-primary border-l-4 border-primary transition-colors font-data-mono text-data-mono rounded-r-DEFAULT" href="#"><span class="material-symbols-outlined" data-icon="lightbulb">lightbulb</span> Target Audience</a></li>
                <li><a class="flex items-center gap-xs px-sm py-xs text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors font-data-mono text-data-mono rounded-DEFAULT" href="#"><span class="material-symbols-outlined" data-icon="add_circle">add_circle</span> Create Idea</a></li>
            </ul>
        </div>
        <div class="px-md flex flex-col gap-md">
            <button class="w-full py-xs px-sm bg-primary text-on-primary-fixed font-bold font-data-mono text-data-mono rounded-lg hover:bg-primary-container transition-colors">Deploy Agent</button>
            <ul class="flex flex-col gap-sm">
                <li><a class="flex items-center gap-xs px-sm py-xs text-on-surface-variant hover:text-on-surface transition-colors font-data-mono text-data-mono" href="#"><span class="material-symbols-outlined" data-icon="settings">settings</span> Settings</a></li>
                <li><a class="flex items-center gap-xs px-sm py-xs text-on-surface-variant hover:text-on-surface transition-colors font-data-mono text-data-mono" href="#"><span class="material-symbols-outlined" data-icon="help">help</span> Support</a></li>
                <li><a class="flex items-center gap-xs px-sm py-xs text-on-surface-variant hover:text-on-surface transition-colors font-data-mono text-data-mono" href="#"><span class="material-symbols-outlined" data-icon="logout">logout</span> Logout</a></li>
            </ul>
        </div>
    </nav>
        <!-- TopAppBar -->
        <header class="flex flex-col gap-sm p-md bg-surface-dim/50 backdrop-blur-xl full-width border-b border-primary/20 shadow-lg shadow-primary/5 sticky top-0 z-30">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-sm text-primary">
                    <span class="material-symbols-outlined text-[32px]" data-icon="group">group</span>
                    <h2 class="font-headline-lg text-headline-lg font-bold">Target Audience</h2>
                </div>
                <div class="flex gap-sm">
                    <button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded-lg transition-colors"><span class="material-symbols-outlined" data-icon="refresh">refresh</span></button>
                    <button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded-lg transition-colors"><span class="material-symbols-outlined" data-icon="ios_share">ios_share</span></button>
                </div>
            </div>
        </header>
        <!-- Content Canvas -->
        <div class="p-md flex flex-col gap-lg max-w-container-max mx-auto w-full flex-1">
            <!-- Segmentation Overview -->
            <section class="grid grid-cols-1 lg:grid-cols-3 gap-md">
                <div class="lg:col-span-2 flex flex-col gap-md">
                    <h3 class="font-headline-md text-headline-md text-on-surface font-semibold border-b border-primary/20 pb-xs">Audience Segments</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                        <!-- Primary Audience -->
                        <div class="glass-panel p-md rounded-xl flex flex-col gap-sm transition-all duration-300">
                            <div class="flex items-center justify-between border-b border-primary/10 pb-xs">
                                <h4 class="font-label-caps text-label-caps text-secondary">Primary Audience</h4>
                                <span class="material-symbols-outlined text-secondary text-sm">stars</span>
                            </div>
                            <h5 class="font-headline-md text-headline-md text-primary mt-xs">Tech-Savvy Fitness Enthusiasts</h5>
                            <p class="font-body-md text-body-md text-on-surface-variant">Individuals aged 25-40 who integrate technology seamlessly into their daily health and fitness routines. High disposable income, prioritize data-driven insights.</p>
                            <div class="flex flex-wrap gap-xs mt-auto pt-sm border-t border-primary/10">
                                <span class="px-xs py-[2px] bg-primary/10 text-primary font-data-mono text-[10px] rounded">Health Tracking</span>
                                <span class="px-xs py-[2px] bg-primary/10 text-primary font-data-mono text-[10px] rounded">Performance</span>
                                <span class="px-xs py-[2px] bg-primary/10 text-primary font-data-mono text-[10px] rounded">Early Adopters</span>
                            </div>
                        </div>
                        <!-- Secondary Audience -->
                        <div class="glass-panel p-md rounded-xl flex flex-col gap-sm transition-all duration-300">
                            <div class="flex items-center justify-between border-b border-primary/10 pb-xs">
                                <h4 class="font-label-caps text-label-caps text-on-surface-variant">Secondary Audience</h4>
                                <span class="material-symbols-outlined text-on-surface-variant text-sm">accessibility_new</span>
                            </div>
                            <h5 class="font-headline-md text-headline-md text-on-surface mt-xs">Proactive Wellness Seekers</h5>
                            <p class="font-body-md text-body-md text-on-surface-variant">Individuals aged 35-55 focusing on preventative health, stress management, and overall well-being. Value simplicity and actionable advice over raw data.</p>
                            <div class="flex flex-wrap gap-xs mt-auto pt-sm border-t border-primary/10">
                                <span class="px-xs py-[2px] bg-surface-variant text-on-surface-variant font-data-mono text-[10px] rounded">Stress Mgmt</span>
                                <span class="px-xs py-[2px] bg-surface-variant text-on-surface-variant font-data-mono text-[10px] rounded">Sleep Quality</span>
                                <span class="px-xs py-[2px] bg-surface-variant text-on-surface-variant font-data-mono text-[10px] rounded">Longevity</span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Donut Chart Placeholder (CSS Visual) -->
                <div class="glass-panel p-md rounded-xl flex flex-col items-center justify-center relative overflow-hidden">
                    <h4 class="font-label-caps text-label-caps text-on-surface absolute top-md left-md">Market Distribution</h4>
                    <!-- CSS Donut Chart Approximation -->
                    <div class="w-48 h-48 rounded-full border-[16px] border-surface-variant relative mt-lg">
                        <div class="absolute inset-[-16px] rounded-full border-[16px] border-primary" style="clip-path: polygon(50% 50%, 50% 0, 100% 0, 100% 100%, 0 100%, 0 50%); transform: rotate(45deg);"></div>
                        <div class="absolute inset-[-16px] rounded-full border-[16px] border-secondary" style="clip-path: polygon(50% 50%, 50% 0, 100% 0); transform: rotate(315deg);"></div>
                        <div class="absolute inset-0 flex flex-col items-center justify-center bg-surface-container rounded-full m-1">
                            <span class="font-headline-md text-headline-md text-primary">65%</span>
                            <span class="font-label-caps text-[10px] text-on-surface-variant">Primary</span>
                        </div>
                    </div>
                    <div class="flex gap-sm mt-md">
                        <div class="flex items-center gap-xs"><div class="w-3 h-3 bg-primary rounded-sm"></div><span class="font-data-mono text-[12px] text-on-surface-variant">Primary</span></div>
                        <div class="flex items-center gap-xs"><div class="w-3 h-3 bg-secondary rounded-sm"></div><span class="font-data-mono text-[12px] text-on-surface-variant">Secondary</span></div>
                        <div class="flex items-center gap-xs"><div class="w-3 h-3 bg-surface-variant rounded-sm"></div><span class="font-data-mono text-[12px] text-on-surface-variant">Tertiary</span></div>
                    </div>
                </div>
            </section>
            <!-- AI Personas Section -->
            <section class="flex flex-col gap-md mt-md">
                <div class="flex items-center justify-between border-b border-primary/20 pb-xs">
                    <h3 class="font-headline-md text-headline-md text-on-surface font-semibold flex items-center gap-xs"><span class="material-symbols-outlined text-primary">smart_toy</span> AI Synthesized Personas</h3>
                    <span class="px-xs py-[2px] bg-secondary/20 text-secondary font-label-caps text-[10px] rounded border border-secondary/30">Confidence: 94%</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
                    <!-- Persona 1 -->
                    <div class="glass-panel p-md rounded-xl flex flex-col gap-sm group">
                        <div class="flex items-center gap-sm border-b border-primary/10 pb-sm">
                            <div class="w-12 h-12 rounded-full overflow-hidden border border-primary/50 group-hover:border-primary transition-colors">
                                <img alt="Alex Avatar" class="w-full h-full object-cover" data-alt="A futuristic, high-contrast cybernetic portrait of a 30-year-old male athlete. Dark background with neon green highlights illuminating his focused expression. He wears sleek, minimalist smart tech gear. Professional, cinematic lighting, ultra-detailed." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDOa9O4LSiRSroLw-FWzTOrkMZPnrQwe-Uf0zHfz-uNOfWjbJznFtkfeAwdsnn6ASWPWeColmd0JObQhF0zt9TkDJZ_4dv8f0Gqz-aDsRTx3S46FuWTqhEWl4aNCHBwK3jaBCNJsK_RbE3ifkaAhGaQ_5RVJEXgesh0DCapj03fi6CE3CgL8jdEqAgJeAHfhTcmZebtydpTNF56q5hA55RLTseWgqc8iqivjT8x4F3HkpOdbitN8CLz" />
                            </div>
                            <div>
                                <h4 class="font-headline-md text-[20px] text-on-surface">Alex "The Optimizer"</h4>
                                <p class="font-data-mono text-[12px] text-primary">Data-Driven Triathlete, 32</p>
                            </div>
                        </div>
                        <p class="font-body-md text-[14px] text-on-surface-variant leading-relaxed">"I need to know exactly when my body is primed for maximum output and when I'm risking overtraining."</p>
                        <div class="mt-xs">
                            <h5 class="font-label-caps text-[10px] text-secondary mb-xs">Goals</h5>
                            <ul class="font-body-md text-[13px] text-on-surface-variant list-disc pl-sm space-y-1">
                                <li>Shave seconds off PRs</li>
                                <li>Perfect macro tracking integration</li>
                                <li>Actionable recovery insights</li>
                            </ul>
                        </div>
                        <div class="mt-xs">
                            <h5 class="font-label-caps text-[10px] text-error mb-xs">Pain Points</h5>
                            <ul class="font-body-md text-[13px] text-on-surface-variant list-disc pl-sm space-y-1">
                                <li>Inaccurate HR spikes during intervals</li>
                                <li>Siloed data across multiple apps</li>
                                <li>Clunky hardware during swims</li>
                            </ul>
                        </div>
                    </div>
                    <!-- Persona 2 -->
                    <div class="glass-panel p-md rounded-xl flex flex-col gap-sm group">
                        <div class="flex items-center gap-sm border-b border-primary/10 pb-sm">
                            <div class="w-12 h-12 rounded-full overflow-hidden border border-secondary/50 group-hover:border-secondary transition-colors">
                                <img alt="Elena Avatar" class="w-full h-full object-cover" data-alt="A portrait of a serene but busy 45-year-old female executive in a modern, dark-themed office environment. Soft cyan and cool blue ambient lighting. She looks thoughtful, wearing a subtle, elegant smartwatch. Cybernetic corporate aesthetic." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCsUxESus_UzWNkV79IN8SEMde0DbYvvST5Hu32vmBOfISkiVeptUn5TPb53Wjp4QVAbzLfwgTHUeRxyuLe31Tl7v0aC6VONa-_vjF5D7IMhQmkAFkfNA8MYBSpLoZmwMloOSnQ0WihhVMyUHSgLEnVdd3gWdFOhTEA_GkOnZt92quECHNp73-xi23kfzMSzwyO5jFGqQXyJs-gxBpwKA1Vs_3lJu29wbW82vQ5EtAIk74xkM1JiVWX" />
                            </div>
                            <div>
                                <h4 class="font-headline-md text-[20px] text-on-surface">Elena "The Balancer"</h4>
                                <p class="font-data-mono text-[12px] text-secondary">Tech Executive, 45</p>
                            </div>
                        </div>
                        <p class="font-body-md text-[14px] text-on-surface-variant leading-relaxed">"Between board meetings and flights, I need simple nudges to manage stress and keep my baseline health stable."</p>
                        <div class="mt-xs">
                            <h5 class="font-label-caps text-[10px] text-secondary mb-xs">Goals</h5>
                            <ul class="font-body-md text-[13px] text-on-surface-variant list-disc pl-sm space-y-1">
                                <li>Maintain consistent energy levels</li>
                                <li>Monitor sleep quality during travel</li>
                                <li>Discreet stress interventions</li>
                            </ul>
                        </div>
                        <div class="mt-xs">
                            <h5 class="font-label-caps text-[10px] text-error mb-xs">Pain Points</h5>
                            <ul class="font-body-md text-[13px] text-on-surface-variant list-disc pl-sm space-y-1">
                                <li>Information overload from too many metrics</li>
                                <li>Aesthetics that don't match business attire</li>
                                <li>Short battery life on trips</li>
                            </ul>
                        </div>
                    </div>
                    <!-- Persona 3 -->
                    <div class="glass-panel p-md rounded-xl flex flex-col gap-sm group">
                        <div class="flex items-center gap-sm border-b border-primary/10 pb-sm">
                            <div class="w-12 h-12 rounded-full overflow-hidden border border-tertiary/50 group-hover:border-tertiary transition-colors">
                                <img alt="Mark Avatar" class="w-full h-full object-cover" data-alt="A casual portrait of a 24-year-old male student in an urban night setting. Neon lights reflect off his glasses. He looks curious and engaged with technology. Cyberpunk street style, dark cinematic tones, high resolution." src="https://lh3.googleusercontent.com/aida-public/AB6AXuCSCse-Gpa28WVUz_-cy_EXJS1MWc8bHJSRTOzKaJc7v2H7lJcCumCzQuTHpBBJYWyKgvB9uyOyXx0XL-eX6LrXc6lTI2E_15iPb7TfPiJKcq6M80fqPFTtkhIqWuaAzgtLcafijm-AC3bTPRhcn9cd1XUVllnVpq3yHgMBMUg-LDuUtG4YdIROchofYTT5MoXz_9D8CA2fz-AC5WCFLGMtcEwtfR32IpDu84dq85y2CQJ6hA9zw0LT" />
                            </div>
                            <div>
                                <h4 class="font-headline-md text-[20px] text-on-surface">Mark "The Explorer"</h4>
                                <p class="font-data-mono text-[12px] text-tertiary">Bio-hacking Student, 24</p>
                            </div>
                        </div>
                        <p class="font-body-md text-[14px] text-on-surface-variant leading-relaxed">"I want to experiment with my routine and see the raw data changes instantly. The more APIs, the better."</p>
                        <div class="mt-xs">
                            <h5 class="font-label-caps text-[10px] text-secondary mb-xs">Goals</h5>
                            <ul class="font-body-md text-[13px] text-on-surface-variant list-disc pl-sm space-y-1">
                                <li>Access raw sensor data streams</li>
                                <li>Gamify daily movement goals</li>
                                <li>Connect with open-source health communities</li>
                            </ul>
                        </div>
                        <div class="mt-xs">
                            <h5 class="font-label-caps text-[10px] text-error mb-xs">Pain Points</h5>
                            <ul class="font-body-md text-[13px] text-on-surface-variant list-disc pl-sm space-y-1">
                                <li>Walled-garden ecosystems (no data export)</li>
                                <li>High entry cost for pro features</li>
                                <li>Lack of granular customization</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </div>