@code
{
     [Parameter]public Guid Id {get;set;}

     private HubConnection hub;
     private AnalysisStatusView status;
     private List<string> logs = new List<string>();

      protected override async Task OnInitializedAsync()
    {
        // 1. Connect and start listening
        hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/analysis"),
                     o => o.AccessTokenProvider = () => Auth.GetTokenAsync())
            .WithAutomaticReconnect()
            .Build();

        hub.On<AnalysisEvent>("AnalysisEvent", OnEventAsync);
        hub.Reconnected += async _ => await LoadStatusAsync();   // catch up after a dropped connection

        await hub.StartAsync();
        logs.Add("> Свързано. Изчакване на събития…");

        // 2. Then load the current state (the endpoint)
        await LoadStatusAsync();
    }

     private async Task LoadStatusAsync()
    {
        status = await analyses.GetStatusAsync(Id);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnEventAsync(AnalysisEvent e)
    {
        if (e.AnalysisId != Id || status is null) return;

        var module = status.Modules.FirstOrDefault(m => m.Key == e.Module);
        if (module == null || module.Status == "Completed" || module.Status == "Failed")
        {
            return;
        }  // already done

        switch (e.Stage)
        {
            case ProgressStage.Log:
                logs.Add($"> {e.Message}");
                if (logs.Count > 100) logs.RemoveAt(0);
                break;
            case ProgressStage.Completed:
            case ProgressStage.Failed:
                module.Status = e.Stage.ToString();
                status.Done++;

                if (status.Done == status.Total) Nav.NavigateTo($"/analyses/{Id}");   // results page
                break;
            default:
                module.Status = "Running";
                module.Label = e.Stage switch
                {
                    ProgressStage.ResearchStarted => "ПРОУЧВАНЕ…",
                    ProgressStage.Searching       => "ТЪРСЕНЕ…",
                    ProgressStage.ScoringStarted  => "ОЦЕНЯВАНЕ…",
                    ProgressStage.Partial         => "ПИШЕ…",
                    _ => module.Label
                };
                break;
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (hub != null) await hub.DisposeAsync();
    }

}