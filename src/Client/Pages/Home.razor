@page "/home"
@layout AccountLayout
@attribute [Authorize]
@inherits IdeaBoardPage
@* Dashboard for signed-in users: totals, the analyses running right now and the latest ideas.
   Updates itself when a module or an analysis finishes (IdeaBoardPage). *@

<PageTitle>Табло | InnovaFlow</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="css/home.css" />
</HeadContent>

@{
    var ready = Cards is not null;
    var cards = Cards ?? [];
    var total = cards.Count;
    var newThisWeek = cards.Count(c => c.Idea.CreatedAt > DateTimeOffset.UtcNow.AddDays(-7));
    var analyzed = cards.Count(c => c.LastCompleted is not null);
    var scores = cards.Where(c => c.Score is not null).Select(c => c.Score!.Value).ToList();
    int? average = scores.Count > 0 ? (int)Math.Round(scores.Average()) : null;
    var running = cards.Where(c => c.IsRunning).ToList();
}

<div class="fixed inset-0 grid-background pointer-events-none z-[-1]"></div>
<div class="w-full p-md md:p-xl flex flex-col gap-xl">
    <header class="w-full flex flex-col md:flex-row md:items-end justify-between gap-md border-b border-primary/20 pb-md">
        <div>
            <p class="font-label-caps text-label-caps text-on-surface-variant mb-2">ОБЩ ПРЕГЛЕД</p>
            <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-on-surface">
                @Greeting()@(userName is null ? "" : $", {userName}") <span class="text-2xl">👋</span>
            </h2>
            <p class="font-body-md text-body-md text-on-surface-variant mt-2 max-w-2xl">
                Разгледайте идеите си и открийте техния потенциал. Резултатите се обновяват, докато агентите работят.
            </p>
        </div>
        <div class="flex items-center gap-4 flex-wrap">
            @if (LoadFailed)
            {
                <button type="button" @onclick="ReloadAsync"
                        class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-error/40 bg-error/10 text-error font-data-mono text-[12px]">
                    <span class="material-symbols-outlined text-[16px]">refresh</span>
                    Данните не се заредиха. Опитай отново
                </button>
            }
            else if (running.Count > 0)
            {
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-tertiary/30 bg-surface-container/50">
                    <span class="w-2 h-2 rounded-full bg-tertiary animate-pulse"></span>
                    <span class="font-data-mono text-[12px] text-tertiary">Агентите работят: @running.Count</span>
                </div>
            }
            else
            {
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-primary/30 bg-surface-container/50">
                    <span class="w-2 h-2 rounded-full bg-primary"></span>
                    <span class="font-data-mono text-[12px] text-primary">Агентите са в готовност</span>
                </div>
            }
            <a href="ideas/create"
               class="bg-primary text-on-primary-fixed font-bold px-6 py-3 rounded hover:brightness-110 transition-all flex items-center gap-2 border border-primary">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">add</span>
                Създай нова идея
            </a>
        </div>
    </header>

    <!-- Stats Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-md">
        <div class="bg-surface-container border border-primary/10 rounded-lg p-md hover:border-primary/40 hover:shadow-[0_0_15px_rgba(107,251,154,0.1)] transition-all relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-[48px] text-primary">lightbulb</span>
            </div>
            <p class="font-label-caps text-label-caps text-on-surface-variant mb-4">ОБЩО ИДЕИ</p>
            <p class="font-display-lg text-display-lg text-on-surface"><Loading Ready="ready" Size="lg">@total</Loading></p>
            <div class="mt-4 flex items-center gap-2 text-primary font-data-mono text-[12px]">
                @if (ready && newThisWeek > 0)
                {
                    <span class="material-symbols-outlined text-[14px]">trending_up</span>
                    <span>+@newThisWeek тази седмица</span>
                }
                else if (ready)
                {
                    <span class="text-on-surface-variant">Няма нови тази седмица</span>
                }
            </div>
        </div>

        <div class="bg-surface-container border border-primary/10 rounded-lg p-md hover:border-primary/40 hover:shadow-[0_0_15px_rgba(107,251,154,0.1)] transition-all relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-[48px] text-primary">analytics</span>
            </div>
            <p class="font-label-caps text-label-caps text-on-surface-variant mb-4">АНАЛИЗИРАНИ</p>
            <p class="font-display-lg text-display-lg text-on-surface"><Loading Ready="ready" Size="lg">@analyzed</Loading></p>
            <div class="mt-4 w-full bg-surface-variant h-1 rounded-full overflow-hidden">
                <div class="bg-primary h-full rounded-full transition-[width] duration-700" style="width: @(total == 0 ? 0 : analyzed * 100 / total)%"></div>
            </div>
        </div>

        <div class="bg-surface-container border border-primary/10 rounded-lg p-md hover:border-primary/40 hover:shadow-[0_0_15px_rgba(107,251,154,0.1)] transition-all relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-[48px] text-secondary">radar</span>
            </div>
            <p class="font-label-caps text-label-caps text-on-surface-variant mb-4">СРЕДЕН РЕЗУЛТАТ</p>
            <p class="font-display-lg text-display-lg text-@IdeaText.ScoreColor(average)">
                <Loading Ready="ready" Size="lg">@(average?.ToString() ?? "--")<span class="text-headline-md text-on-surface-variant">/100</span></Loading>
            </p>
            <div class="mt-4 flex items-center gap-2 text-@IdeaText.ScoreColor(average) font-data-mono text-[12px]">
                <span>@(average is { } avg ? IdeaText.Potential(avg) : ready ? "Още няма анализи" : "")</span>
            </div>
        </div>

        <div class="bg-surface-container border border-primary/10 rounded-lg p-md hover:border-primary/40 hover:shadow-[0_0_15px_rgba(107,251,154,0.1)] transition-all relative overflow-hidden group @(running.Count > 0 ? "shimmer-line" : "")">
            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-[48px] text-tertiary">autorenew</span>
            </div>
            <p class="font-label-caps text-label-caps text-on-surface-variant mb-4">В ПРОГРЕС</p>
            <p class="font-display-lg text-display-lg text-tertiary"><Loading Ready="ready" Size="lg">@running.Count</Loading></p>
            <div class="mt-4 flex items-center gap-2 text-tertiary font-data-mono text-[12px] @(running.Count > 0 ? "animate-pulse" : "")">
                <span class="material-symbols-outlined text-[14px]">memory</span>
                <span>@(running.Count > 0 ? "Агентите работят..." : "Няма активни анализи")</span>
            </div>
        </div>
    </section>

    <!-- Active analyses -->
    <section class="bg-[#121b2d] border border-primary/20 rounded-xl overflow-hidden shadow-lg shadow-primary/5">
        <div class="bg-surface-dim/50 border-b border-primary/20 px-md py-4 flex items-center justify-between backdrop-blur-md">
            <div class="flex items-center gap-3 text-primary">
                <span class="material-symbols-outlined">hub</span>
                <h3 class="font-data-mono text-data-mono uppercase tracking-wider">Активни анализи</h3>
            </div>
            <span class="material-symbols-outlined text-primary/30 text-[32px]">memory</span>
        </div>
        <div class="p-4 md:p-md flex flex-col gap-sm">
            @if (!ready)
            {
                <Loading Ready="false" Block Label="Зареждане…" Class="py-md" />
            }
            else if (running.Count == 0)
            {
                <div class="border border-primary/10 bg-surface-container/30 rounded p-sm flex items-center gap-4">
                    <div class="w-10 h-10 rounded-full border border-primary/30 flex items-center justify-center bg-primary/5 text-primary">
                        <span class="material-symbols-outlined text-[20px]">psychology</span>
                    </div>
                    <div>
                        <p class="font-data-mono text-[14px] text-on-surface">Всички агенти са в готовност</p>
                        <p class="font-data-mono text-[12px] text-on-surface-variant">Създайте идея или пуснете нов анализ от „Моите идеи“.</p>
                    </div>
                </div>
            }
            else
            {
                @foreach (var c in running)
                {
                    var a = c.Latest!;
                    var pct = a.TotalModules == 0 ? 0 : a.CompletedModules * 100 / a.TotalModules;
                    <a href="start-analysis/@a.Id"
                       class="border border-primary/30 bg-primary/5 rounded p-sm flex flex-col md:flex-row md:items-center justify-between gap-4 relative overflow-hidden hover:border-primary/60 transition-colors">
                        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-primary/5 to-transparent w-[200%] animate-[shimmer_2s_infinite_linear] pointer-events-none"></div>
                        <div class="flex items-center gap-4 relative z-10 min-w-0">
                            <div class="w-10 h-10 shrink-0 rounded-full border border-primary flex items-center justify-center bg-primary/20 text-primary pulse-glow">
                                <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">science</span>
                            </div>
                            <div class="min-w-0">
                                <p class="font-data-mono text-[14px] text-on-surface font-bold truncate">@c.Idea.Title</p>
                                <p class="font-data-mono text-[12px] text-primary">
                                    @(a.Status == Contracts.AnalysisStatus.Pending ? "В опашката..." : "Обработване на данни...") · @IdeaText.Ago(a.StartedAt ?? c.Idea.CreatedAt)
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 relative z-10 md:w-56">
                            <div class="flex-1 h-1 bg-surface-variant rounded-full overflow-hidden">
                                <div class="h-full bg-primary transition-[width] duration-700" style="width: @pct%"></div>
                            </div>
                            <span class="font-data-mono text-[12px] px-2 py-1 bg-primary/20 border border-primary/30 rounded text-primary whitespace-nowrap">
                                @a.CompletedModules/@(a.TotalModules == 0 ? "?" : a.TotalModules) модула
                            </span>
                        </div>
                    </a>
                }
            }
        </div>
    </section>

    <!-- Your ideas -->
    <section>
        <div class="flex items-center justify-between mb-md">
            <h3 class="font-headline-md text-headline-md text-on-surface">Твоите Идеи</h3>
            <a class="font-data-mono text-data-mono text-primary hover:underline flex items-center gap-1" href="ideas">
                Виж всички <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
        </div>

        @if (!ready)
        {
            <Loading Ready="false" Block Size="lg" Label="Зареждане на идеите…" Class="py-xl" />
        }
        else if (cards.Count == 0)
        {
            <div class="border border-dashed border-primary/30 rounded-lg p-xl flex flex-col items-center gap-sm text-center">
                <span class="material-symbols-outlined text-primary text-4xl">lightbulb</span>
                <p class="font-body-md text-body-md text-on-surface">Все още нямате идеи.</p>
                <a href="ideas/create" class="font-data-mono text-data-mono text-primary hover:underline">Създайте първата си идея →</a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-md">
                @foreach (var c in cards.Take(3))
                {
                    var (category, _) = IdeaText.Category(c.Idea.Category);
                    var subtitle = string.IsNullOrWhiteSpace(c.Idea.Industry) ? category : $"{c.Idea.Industry} / {category}";
                    var accent = c.IsRunning ? "tertiary" : c.LastFailed && c.Score is null ? "error" : "primary";

                    <a href="@(c.ViewLink ?? "ideas")"
                       class="bg-[#1e293b]/80 backdrop-blur-md border border-@accent/20 rounded-lg p-md flex flex-col gap-4 hover:border-@accent/50 hover:shadow-[0_0_15px_rgba(107,251,154,0.1)] transition-all cursor-pointer relative overflow-hidden group">
                        @if (c.IsRunning)
                        {
                            var a = c.Latest!;
                            <div class="absolute bottom-0 left-0 h-1 bg-tertiary animate-pulse transition-[width] duration-700"
                                 style="width: @(a.TotalModules == 0 ? 10 : Math.Max(10, a.CompletedModules * 100 / a.TotalModules))%"></div>
                        }
                        <div class="flex justify-between items-start gap-sm border-b border-primary/10 pb-4">
                            <div class="min-w-0">
                                <h4 class="font-headline-md text-[20px] text-on-surface font-bold group-hover:text-@accent transition-colors truncate">@c.Idea.Title</h4>
                                <p class="font-data-mono text-[12px] text-on-surface-variant mt-1 truncate">@subtitle</p>
                            </div>
                            <StatusBadge Card="c" />
                        </div>

                        @if (c.IsRunning)
                        {
                            <div class="flex-1 flex flex-col justify-center">
                                <p class="font-data-mono text-[13px] text-tertiary text-center animate-pulse">
                                    Анализ: @c.Latest!.CompletedModules от @(c.Latest.TotalModules == 0 ? "?" : c.Latest.TotalModules) модула
                                </p>
                            </div>
                        }
                        else if (c.Score is { } score)
                        {
                            <div class="flex-1">
                                <p class="font-label-caps text-on-surface-variant mb-2">ПОТЕНЦИАЛЕН РЕЗУЛТАТ</p>
                                <div class="flex items-end gap-2">
                                    <span class="font-display-lg text-[40px] leading-none text-@IdeaText.ScoreColor(score)">@score</span>
                                    <span class="font-data-mono text-on-surface-variant mb-1">/100</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="flex-1 font-body-md text-[14px] text-on-surface-variant line-clamp-3">@c.Idea.Description</p>
                        }

                        <div class="pt-4 mt-auto border-t border-primary/10 flex justify-between items-center text-[12px] font-data-mono text-on-surface-variant">
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-[14px]">schedule</span>@IdeaText.Ago(c.LastActivity)
                            </span>
                            <span class="@(c.ViewLink is null ? "opacity-50" : "group-hover:text-primary") transition-colors">Детайли →</span>
                        </div>
                    </a>
                }
            </div>
        }
    </section>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string? userName;

    protected override async Task OnInitializedAsync()
    {
        // the token only carries the e-mail; greet with the part before the @
        if (AuthState is not null)
        {
            var email = (await AuthState).User.Identity?.Name;
            userName = email?.Split('@')[0] is { Length: > 0 } local ? local : null;
        }
        await base.OnInitializedAsync();
    }

    private static string Greeting() => DateTime.Now.Hour switch
    {
        < 5 => "Добър вечер",
        < 12 => "Добро утро",
        < 18 => "Добър ден",
        _ => "Добър вечер"
    };
}
