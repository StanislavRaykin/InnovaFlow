@page "/analyses/{AnalysisId:guid}"
@layout AccountLayout
@attribute [Authorize]
@inherits LiveModulePage

<PageTitle>Обзор на анализа | InnovaFlow</PageTitle>

@{
    // Module scores stream in from the live cards; the overall score is the worker's weighted total,
    // set once every module has finished (Live.Status, reloaded on the "analysis done" push).
    var status = Live.Status?.Status;
    var overall = Live.Status?.OverallScore;
    var overallReady = overall is not null;
    var overallColor = IdeaText.ScoreColor(overall);
}

<!-- Subtle Grid Background -->
<div class="fixed inset-0 pointer-events-none z-0"
     style="background-image: linear-gradient(to right, rgba(107, 251, 154, 0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(107, 251, 154, 0.03) 1px, transparent 1px); background-size: 24px 24px;">
</div>
<!-- TopAppBar -->
<header
    class="bg-surface-dim/50 backdrop-blur-xl text-primary font-headline-lg text-headline-lg font-bold full-width border-b border-primary/20 shadow-lg shadow-primary/5 flex flex-col gap-sm p-md sticky top-16 md:top-0 z-30">
    <div class="flex justify-between items-center w-full max-w-container-max mx-auto">
        <div class="flex items-center gap-sm">
            <span class="material-symbols-outlined text-[32px]">analytics</span>
            <h1 class="text-primary font-bold">Обзор на анализа</h1>
            @if (status is "Pending" or "Running")
            {
                <span class="font-data-mono text-[12px] text-secondary animate-pulse">@Live.Status!.Done/@Live.Status.Total МОДУЛА</span>
            }
        </div>
    </div>
    <AnalysisTabs AnalysisId="AnalysisId" />
</header>
<div class="p-md max-w-container-max mx-auto w-full grid grid-cols-12 gap-md mt-md">
    <!-- Primary Score - Left Column -->
    <div class="col-span-12 lg:col-span-4 flex flex-col gap-md">
        <div
            class="bg-surface-container rounded-xl border border-primary/10 p-md relative overflow-hidden group hover:border-primary/40 hover:shadow-[0_0_15px_rgba(107,251,154,0.2)] transition-all duration-300">
            <div
                class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary/50 to-transparent">
            </div>
            <h2
                class="font-label-caps text-label-caps text-on-surface-variant mb-md flex items-center gap-xs border-b border-primary/10 pb-xs">
                <span class="material-symbols-outlined text-[16px]">speed</span>
                ОБЩА ОЦЕНКА
            </h2>
            <div class="flex flex-col items-center justify-center py-lg relative">
                <!-- SVG Gauge -->
                <div class="relative w-48 h-48">
                    <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
                        <circle class="text-surface-variant" cx="50" cy="50" fill="none" r="45" stroke="currentColor"
                                stroke-width="8"></circle>
                        <circle class="text-@overallColor transition-[stroke-dashoffset] duration-1000 ease-out" cx="50" cy="50"
                                fill="none" r="45" stroke="currentColor" stroke-width="8"
                                stroke-dasharray="@Css(Ring)" stroke-dashoffset="@Css(RingOffset(overall))"></circle>
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        @if (status == "Failed")
                        {
                            <span class="font-display-lg text-display-lg text-on-surface-variant font-bold">--</span>
                        }
                        else
                        {
                            <span class="font-display-lg text-display-lg text-on-surface font-bold"><Loading Ready="overallReady" Size="lg">@overall</Loading></span>
                        }
                        <span class="font-data-mono text-data-mono text-on-surface-variant">/100</span>
                    </div>
                </div>
                @if (overall is { } score)
                {
                    <div class="mt-sm px-sm py-xs bg-@overallColor/10 border border-@overallColor/30 rounded text-@overallColor font-headline-md text-headline-md text-center">
                        @IdeaText.Potential(score)
                    </div>
                }
                else if (status == "Failed")
                {
                    <div class="mt-sm px-sm py-xs bg-error/10 border border-error/30 rounded text-error font-data-mono text-data-mono text-center">
                        Анализът не завърши
                    </div>
                }
                else
                {
                    <p class="mt-sm font-data-mono text-[12px] text-on-surface-variant text-center">Изчислява се, когато всички модули приключат…</p>
                }
            </div>
        </div>
        <!-- AI Recommendation -->
        <div
            class="bg-surface-container rounded-xl border border-secondary/20 p-md relative overflow-hidden group hover:border-secondary/40 hover:shadow-[0_0_15px_rgba(93,230,255,0.15)] transition-all duration-300 mt-auto">
            <div class="absolute -right-12 -top-12 w-32 h-32 bg-secondary/10 rounded-full blur-2xl"></div>
            <h2 class="font-label-caps text-label-caps text-secondary mb-sm flex items-center gap-xs">
                <span class="material-symbols-outlined text-[16px]">psychology</span>
                AI ПРЕПОРЪКА
            </h2>
            <p class="font-body-md text-body-md text-on-surface-variant">Очаквайте скоро...</p>
        </div>
    </div>
    <!-- Right Column - Metrics -->
    <div class="col-span-12 lg:col-span-8 flex flex-col gap-md">
        <!-- Metrics Grid: one card per module, linking to its tab -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-sm">
            @foreach (var m in Metrics(AnalysisId))
            {
                var ready = m.Score is not null && m.Card.Done(m.Field);
                var failed = m.Card.Status == "Failed";
                <a href="@m.Link"
                   class="bg-surface-container rounded-lg border border-@m.Color/20 p-sm group hover:border-@m.Color/50 hover:shadow-[0_0_15px_rgba(107,251,154,0.1)] transition-all">
                    <div class="flex items-center justify-between font-label-caps text-label-caps text-on-surface-variant mb-xs">
                        <span>@m.Title</span>
                        <span class="material-symbols-outlined text-[16px] opacity-0 group-hover:opacity-100 transition-opacity">arrow_forward</span>
                    </div>
                    <div class="flex items-end gap-xs">
                        @if (failed)
                        {
                            <span class="font-headline-lg text-headline-lg text-on-surface-variant">--</span>
                            <span class="font-data-mono text-[12px] text-error mb-1">неуспешен</span>
                        }
                        else
                        {
                            <Loading Ready="ready">
                                <span class="font-headline-lg text-headline-lg text-@m.Color">@m.Score</span>
                                <span class="font-data-mono text-[12px] text-on-surface-variant mb-1">/100</span>
                            </Loading>
                        }
                    </div>
                    <div class="w-full h-1 bg-surface-variant mt-sm rounded-full overflow-hidden">
                        <div class="h-full bg-@m.Color transition-[width] duration-700" style="width: @(ready ? m.Score : 0)%"></div>
                    </div>
                    @if (m.Hint is not null)
                    {
                        <div class="mt-xs font-data-mono text-[10px] text-on-surface-variant">@m.Hint</div>
                    }
                </a>
            }
        </div>
        <!-- Key Findings -->
        <div class="bg-surface-container rounded-xl border border-primary/10 p-md">
            <h3
                class="font-headline-md text-headline-md text-on-surface mb-sm flex items-center gap-sm border-b border-primary/10 pb-xs">
                <span class="material-symbols-outlined text-secondary">fact_check</span>
                Ключови открития
            </h3>
            <p class="font-body-md text-body-md text-on-surface-variant">Очаквайте скоро...</p>
        </div>
    </div>
</div>

@code {
    private const double Ring = 2 * Math.PI * 45;     // circumference of the r=45 circle

    private static double RingOffset(int? score) => Ring * (1 - Math.Clamp(score ?? 0, 0, 100) / 100.0);

    // SVG needs "282.74"; a bg-BG browser would format it as "282,74"
    private static string Css(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    /// <param name="Field">JSON field of the score, so it shows only once fully streamed.</param>
    private sealed record Metric(string Title, IModuleCard Card, string Field, int? Score, string Color, string Link, string? Hint = null);

    private IEnumerable<Metric> Metrics(Guid id)
    {
        yield return Up("Пазар", Live.Market, "marketOpportunity", Live.Market.Draft?.MarketOpportunity, $"analyses/{id}/market");
        yield return Up("Иновация", Live.Innovation, "overallScore", Live.Innovation.Draft?.OverallScore, $"analyses/{id}/innovation");
        yield return Up("Аудитория", Live.Audience, "overallScore", Live.Audience.Draft?.OverallScore, $"analyses/{id}/audience");
        // Feasibility has no single score; technical feasibility is the one that answers "can it be built"
        yield return Up("Осъществимост", Live.Feasibility, "technicalScore", Live.Feasibility.Draft?.TechnicalScore, $"analyses/{id}/feasibility",
            "техническа");

        // lower is better: coloured by the risk bands (1-33 low, 34-66 medium, 67-100 high)
        var risk = Live.Risk.Draft?.RiskScore;
        yield return new("Риск", Live.Risk, "riskScore", risk,
            risk switch { null or <= 33 => "primary", <= 66 => "tertiary", _ => "error" },
            $"analyses/{id}/risks", "по-ниско е по-добре");
    }

    private static Metric Up(string title, IModuleCard card, string field, int? score, string link, string? hint = null) =>
        new(title, card, field, score, IdeaText.ScoreColor(score), link, hint);
}
