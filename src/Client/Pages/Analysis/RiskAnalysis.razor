@page "/analyses/{AnalysisId:guid}/risks"
@layout AccountLayout
@attribute [Authorize]
@inherits LiveModulePage

<PageTitle>Анализ на риска | InnovaFlow</PageTitle>

@{
    // The AI writes: risks (most serious first), riskScore, riskScoreExplanation, summary
    var card = Live.Risk;
    var d = card.Draft;
    var risks = d?.Risks ?? [];
    var scoreReady = d?.RiskScore is not null && card.Done("riskScore");
    var level = Level(scoreReady ? d!.RiskScore : null);
}

<!-- TopAppBar -->
<header class="flex flex-col gap-sm p-md bg-surface-dim/50 backdrop-blur-xl text-primary font-headline-lg text-headline-lg full-width border-b border-primary/20 shadow-lg shadow-primary/5 sticky top-16 md:top-0 z-30">
    <div class="flex justify-between items-center w-full max-w-container-max mx-auto">
        <div class="flex items-center gap-sm">
            <span class="material-symbols-outlined text-4xl">analytics</span>
            <h1 class="font-headline-lg text-headline-lg font-bold text-primary neon-glow">Анализ на риска</h1>
            @if (!card.IsDone)
            {
                <span class="font-data-mono text-[12px] text-secondary animate-pulse">@(card.Label ?? "ИЗЧАКВАНЕ…")</span>
            }
        </div>
    </div>
    <AnalysisTabs AnalysisId="AnalysisId" />
</header>

@if (card.Status == "Failed")
{
    <div class="p-md max-w-container-max mx-auto w-full">
        <div class="glass-card p-md rounded-lg text-error">Анализът на риска не успя. Опитайте отново.</div>
    </div>
}
else
{
    <!-- Content Canvas -->
    <div class="flex-1 p-md max-w-container-max mx-auto w-full flex flex-col gap-md">
        <!-- Dashboard Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-md">
            <!-- Main Score Card (Span 4) -->
            <div class="glass-card rounded-lg p-sm lg:col-span-4 flex flex-col items-center justify-center text-center relative overflow-hidden @(card.IsActive("riskScoreExplanation") ? "ring-1 ring-primary/40" : "")">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary-container via-primary to-primary-container opacity-50"></div>
                <h2 class="font-label-caps text-label-caps text-on-surface-variant uppercase mb-sm tracking-widest">Общ Риск</h2>
                <div class="relative w-32 h-32 flex items-center justify-center my-md">
                    <svg class="absolute inset-0 w-full h-full transform -rotate-90" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" fill="none" r="45" stroke="#131b2e" stroke-width="8"></circle>
                        <circle class="text-@level.Color transition-[stroke-dashoffset] duration-1000 ease-out" cx="50" cy="50" fill="none" r="45"
                                stroke="currentColor" stroke-width="8"
                                stroke-dasharray="@Css(Ring)" stroke-dashoffset="@Css(RingOffset(scoreReady ? d!.RiskScore : 0))"></circle>
                    </svg>
                    <div class="flex flex-col items-center">
                        <span class="font-display-lg text-display-lg font-bold text-@level.Color"><Loading Ready="scoreReady" Size="lg">@d?.RiskScore</Loading></span>
                        <span class="font-data-mono text-data-mono text-on-surface-variant">/100</span>
                    </div>
                </div>
                <div class="flex items-center gap-xs mt-sm">
                    <span class="w-2 h-2 rounded-full bg-@level.Color @(card.IsDone ? "" : "animate-pulse")"></span>
                    <span class="font-body-md text-body-md text-@level.Color font-bold"><Loading Ready="scoreReady" Size="sm">@level.Text</Loading></span>
                </div>
                <div class="mt-sm text-left w-full">
                    <StreamText Value="@d?.RiskScoreExplanation" Active="@card.IsActive("riskScoreExplanation")" />
                </div>
            </div>

            <!-- Distribution (Span 8) -->
            <div class="glass-card rounded-lg p-sm lg:col-span-8 flex flex-col h-full">
                <div class="flex justify-between items-center mb-md border-b border-primary/10 pb-xs">
                    <h2 class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Разпределение на Риска</h2>
                    <span class="font-data-mono text-[11px] text-on-surface-variant" title="Вероятност × въздействие">вероятност × въздействие</span>
                </div>
                <div class="flex-1 relative min-h-[250px] flex items-end gap-sm pb-xl px-sm">
                    @foreach (var r in risks)
                    {
                        var exposure = Exposure(r);
                        var color = SeverityColor(r.Severity);
                        <div class="flex-1 flex flex-col items-center justify-end h-full relative group">
                            <div class="w-full max-w-[40px] bg-@color/20 border border-@color/50 rounded-t-sm relative transition-all duration-700 group-hover:bg-@color/40 group-hover:border-@color" style="height: @(exposure ?? 0)%;">
                                <div class="absolute top-0 left-0 w-full h-1 bg-@color"></div>
                                <span class="absolute -top-6 left-1/2 transform -translate-x-1/2 font-data-mono text-data-mono text-@color opacity-0 group-hover:opacity-100 transition-opacity">@exposure%</span>
                            </div>
                            <span class="absolute -bottom-8 font-label-caps text-[10px] text-on-surface-variant whitespace-nowrap">@TypeText(r.Type)</span>
                        </div>
                    }
                    @if (!card.Done("risks") || d?.Risks is null)
                    {
                        <Loading Ready="false" Block Size="lg" Label="Изчисляване на рисковете…" Class="flex-1 self-center" />
                    }
                    <!-- Grid Lines -->
                    <div class="absolute left-0 bottom-xl w-full border-t border-surface-variant/50 pointer-events-none"></div>
                    <div class="absolute left-0 bottom-[calc(64px+25%)] w-full border-t border-surface-variant/30 pointer-events-none"></div>
                    <div class="absolute left-0 bottom-[calc(64px+50%)] w-full border-t border-surface-variant/30 pointer-events-none"></div>
                    <div class="absolute left-0 bottom-[calc(64px+75%)] w-full border-t border-surface-variant/30 pointer-events-none"></div>
                </div>
            </div>
        </div>

        <!-- Summary -->
        <section class="glass-card rounded-lg flex flex-col @(card.IsActive("summary") ? "ring-1 ring-primary/40" : "")">
            <div class="px-md py-sm border-b border-primary/10 flex items-center gap-xs">
                <span class="material-symbols-outlined text-secondary text-sm">smart_toy</span>
                <h3 class="font-label-caps text-label-caps text-secondary uppercase">AI Оценка: готовност за старт</h3>
            </div>
            <div class="p-md">
                <StreamText Value="@d?.Summary" Active="@card.IsActive("summary")" Lines="4" />
            </div>
        </section>

        <!-- Risk Cards Section -->
        <div class="mt-md">
            <h3 class="font-headline-md text-headline-md font-bold text-on-surface mb-sm flex items-center gap-xs">
                <span class="material-symbols-outlined text-primary">warning</span>
                Детайлен Анализ на Рисковете
            </h3>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-md">
                @for (var i = 0; i < risks.Count; i++)
                {
                    var r = risks[i];
                    var color = SeverityColor(r.Severity);
                    var active = card.IsActive($"risks[{i}]");
                    <div class="glass-card rounded-lg flex flex-col overflow-hidden transition-all duration-300 @(active ? "ring-1 ring-primary/40" : "")">
                        <div class="p-sm border-b border-primary/10 flex justify-between items-start bg-@color/5">
                            <div class="flex items-center gap-sm min-w-0">
                                <div class="w-10 h-10 shrink-0 rounded-full bg-@color/20 flex items-center justify-center border border-@color/30 text-@color">
                                    <span class="material-symbols-outlined">@TypeIcon(r.Type)</span>
                                </div>
                                <div class="min-w-0">
                                    <h4 class="font-headline-md text-[20px] font-bold text-on-surface">@r.Title</h4>
                                    <span class="font-label-caps text-@color">@SeverityText(r.Severity)</span>
                                </div>
                            </div>
                            <div class="text-right shrink-0">
                                <div class="font-data-mono text-display-lg text-@color">
                                    <Loading Ready="@(r.Probability is not null && card.Done($"risks[{i}].probability"))" Size="sm">@r.Probability<span class="text-body-md">%</span></Loading>
                                </div>
                                <div class="font-label-caps text-on-surface-variant">Вероятност</div>
                            </div>
                        </div>
                        <div class="p-sm flex-1 flex flex-col gap-sm">
                            <p class="font-body-md text-body-md text-on-surface-variant">@r.Description</p>
                            <div class="grid grid-cols-2 gap-sm mt-auto">
                                <div class="bg-surface p-xs rounded border border-surface-variant">
                                    <span class="block font-label-caps text-on-surface-variant mb-1">Въздействие</span>
                                    @if (r.Impact is { } impact && card.Done($"risks[{i}].impact"))
                                    {
                                        <span class="font-data-mono text-@ImpactColor(impact)">@ImpactText(impact) · @impact</span>
                                    }
                                </div>
                                <div class="bg-surface p-xs rounded border border-surface-variant">
                                    <span class="block font-label-caps text-on-surface-variant mb-1">Статус</span>
                                    <span class="font-data-mono @(r.Status == "active" ? "text-primary" : "text-tertiary")">@StatusText(r.Status)</span>
                                </div>
                            </div>
                        </div>
                        <div class="p-sm bg-surface-container-low border-t border-primary/10">
                            <div class="flex items-center gap-xs mb-xs">
                                <span class="material-symbols-outlined text-secondary text-sm">smart_toy</span>
                                <span class="font-label-caps text-secondary uppercase">AI Обобщение</span>
                            </div>
                            <StreamText Value="@r.Mitigation" Active="@card.IsActive($"risks[{i}].mitigation")" Lines="2" />
                        </div>
                    </div>
                }
            </div>
            @if (!card.Done("risks") || d?.Risks is null)
            {
                <Loading Ready="false" Block Size="lg" Label="Анализиране на рисковете…" Class="py-xl" />
            }
        </div>
    </div>
}

@code {
    private const double Ring = 2 * Math.PI * 45;     // circumference of the r=45 circle

    private static double RingOffset(int? score) => Ring * (1 - Math.Clamp(score ?? 0, 0, 100) / 100.0);

    // SVG needs "282.74"; a bg-BG browser would format it as "282,74"
    private static string Css(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // Same bands as the schema: 1-33 low, 34-66 medium, 67-100 high
    private static (string Text, string Color) Level(int? score) => score switch
    {
        null => ("", "primary"),
        <= 33 => ("Нисък общ риск", "primary"),
        <= 66 => ("Среден общ риск", "tertiary"),
        _ => ("Висок общ риск", "error")
    };

    /// <summary>Probability × impact on a 0-100 scale; null until both are in.</summary>
    private static int? Exposure(RiskItemDraft r) =>
        r.Probability is { } p && r.Impact is { } i
            ? (int)Math.Round(Math.Clamp(p, 0, 100) * Math.Clamp(i, 0, 100) / 100.0)
            : null;

    private static string SeverityText(string? severity) => severity switch
    {
        "low" => "Ниска Тежест",
        "medium" => "Средна Тежест",
        "high" => "Висока Тежест",
        "critical" => "Критична Тежест",
        _ => ""
    };

    private static string SeverityColor(string? severity) => severity switch
    {
        "critical" or "high" => "error",
        "medium" => "tertiary",
        _ => "primary"
    };

    private static string ImpactText(int impact) => impact switch
    {
        <= 33 => "Ниско",
        <= 66 => "Средно",
        _ => "Високо"
    };

    private static string ImpactColor(int impact) => impact switch
    {
        <= 33 => "on-surface",
        <= 66 => "tertiary",
        _ => "error"
    };

    private static string StatusText(string? status) => status switch
    {
        "active" => "Активен",
        "monitoring" => "Наблюдение",
        _ => ""
    };

    private static string TypeText(string? type) => type switch
    {
        "market" => "Пазарен",
        "financial" => "Финансов",
        "technical" => "Технически",
        "legal" => "Правен",
        "security" => "Сигурност",
        "competition" => "Конкуренция",
        "scalability" => "Мащабиране",
        _ => "…"
    };

    private static string TypeIcon(string? type) => type switch
    {
        "market" => "storefront",
        "financial" => "payments",
        "technical" => "memory",
        "legal" => "gavel",
        "security" => "shield_lock",
        "competition" => "group",
        "scalability" => "trending_up",
        _ => "help"
    };
}
