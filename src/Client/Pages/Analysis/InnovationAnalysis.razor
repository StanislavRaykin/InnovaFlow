@page "/analyses/{AnalysisId:guid}/innovation"
@layout AccountLayout
@attribute [Authorize]
@inherits LiveModulePage

<PageTitle>Иновации | InnovaFlow</PageTitle>

@{
    // The AI writes the four dimensions (score, then explanation), then summary, overallScore, overallExplanation
    var card = Live.Innovation;
    var d = card.Draft;
    var overallReady = d?.OverallScore != null && card.Done("overallScore");
}

<!-- TopAppBar -->
<header class="flex flex-col gap-sm p-md bg-surface-dim/50 backdrop-blur-xl border-b border-primary/20 shadow-lg shadow-primary/5 sticky top-16 md:top-0 z-30">
    <div class="flex justify-between items-center w-full">
        <div class="flex items-center gap-sm">
            <span class="material-symbols-outlined text-primary text-3xl" style="font-variation-settings: 'FILL' 1;">analytics</span>
            <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-primary">Иновационен Анализ</h2>
            @if (!card.IsDone)
            {
                <span class="font-data-mono text-[12px] text-secondary animate-pulse">@(card.Label ?? "ИЗЧАКВАНЕ…")</span>
            }
        </div>
        <div class="flex gap-sm">
            <button class="p-2 text-on-surface-variant hover:bg-primary/10 rounded-lg transition-all relative overflow-hidden group">
                <span class="material-symbols-outlined relative z-10">refresh</span>
                <div class="absolute inset-0 hidden group-hover:block animate-scan z-0"></div>
            </button>
            <button class="p-2 text-on-surface-variant hover:bg-primary/10 rounded-lg transition-all relative overflow-hidden group">
                <span class="material-symbols-outlined relative z-10">ios_share</span>
                <div class="absolute inset-0 hidden group-hover:block animate-scan z-0"></div>
            </button>
        </div>
    </div>
    <AnalysisTabs AnalysisId="AnalysisId" />
</header>

@if (card.Status == "Failed")
{
    <div class="p-md max-w-container-max mx-auto w-full">
        <div class="glass-panel p-md rounded-xl text-error">Иновационният анализ не успя. Опитайте отново.</div>
    </div>
}
else
{
    <!-- Dashboard Content Grid -->
    <div class="p-md flex-1 grid grid-cols-1 lg:grid-cols-12 gap-md items-start max-w-container-max mx-auto w-full">

        <!-- Left Column: overall + summary -->
        <div class="lg:col-span-8 flex flex-col gap-md">
            <!-- Big Score Card -->
            <section class="glass-panel rounded-xl p-md flex flex-col gap-md relative overflow-hidden @(card.IsActive("overallExplanation") ? "ring-1 ring-primary/40" : "")">
                <div class="absolute top-0 right-0 w-32 h-32 bg-primary/10 rounded-full blur-3xl -mr-16 -mt-16"></div>
                <div class="flex flex-col md:flex-row items-center justify-between gap-md">
                    <div class="flex flex-col z-10">
                        <span class="font-label-caps text-label-caps text-secondary mb-xs">ОБЩ РЕЙТИНГ НА ИНОВАЦИЯТА</span>
                        <div class="flex items-baseline gap-sm">
                            <span class="font-display-lg text-display-lg text-primary neon-text"><Loading Ready="overallReady" Size="lg">@d?.OverallScore</Loading></span>
                            <span class="font-headline-md text-headline-md text-on-surface-variant">/100</span>
                        </div>
                    </div>
                    <!-- Radial Progress -->
                    <div class="w-32 h-32 shrink-0 rounded-full border-4 border-surface-variant relative flex items-center justify-center z-10">
                        <svg class="absolute inset-0 w-full h-full transform -rotate-90">
                            <circle class="text-surface-variant" cx="60" cy="60" fill="transparent" r="54" stroke="currentColor" stroke-width="8"></circle>
                            <circle class="text-primary drop-shadow-[0_0_10px_rgba(74,222,128,0.5)] transition-[stroke-dashoffset] duration-700"
                                    cx="60" cy="60" fill="transparent" r="54" stroke="currentColor" stroke-width="8"
                                    stroke-dasharray="@Css(Ring)" stroke-dashoffset="@Css(RingOffset(overallReady ? d?.OverallScore : 0))"></circle>
                        </svg>
                        <span class="material-symbols-outlined text-4xl text-primary" style="font-variation-settings: 'FILL' 1;">insights</span>
                    </div>
                </div>
                <div class="z-10">
                    <StreamText Value="@d?.OverallExplanation" Active="@card.IsActive("overallExplanation")" />
                </div>
            </section>

            <!-- Summary -->
            <section class="glass-panel rounded-xl flex flex-col @(card.IsActive("summary") ? "ring-1 ring-primary/40" : "")">
                <div class="px-md py-sm border-b border-primary/10 flex items-center gap-xs">
                    <span class="material-symbols-outlined text-secondary text-sm">memory</span>
                    <h3 class="font-label-caps text-label-caps text-secondary">AI АНАЛИЗ: ДИФЕРЕНЦИАЦИЯ И СЛЕДВАЩИ СТЪПКИ</h3>
                </div>
                <div class="p-md">
                    <StreamText Value="@d?.Summary" Active="@card.IsActive("summary")" />
                </div>
            </section>
        </div>

        <!-- Right Column: the four dimensions -->
        <div class="lg:col-span-4 flex flex-col gap-md">
            @foreach (var dim in Dimensions)
            {
                var (score, explanation) = dim.Get(d);
                <ScoreCard Title="@dim.Title" Icon="@dim.Icon" Color="@dim.Color"
                           Score="score" ScoreDone="@card.Done(dim.Key + "Score")"
                           Explanation="@explanation" ExplanationActive="@card.IsActive(dim.Key + "Explanation")" />
            }
        </div>
    </div>
}

@code {
    private const double Ring = 2 * Math.PI * 54;     // circumference of the r=54 circle

    private static double RingOffset(int? score) => Ring * (1 - Math.Clamp(score ?? 0, 0, 100) / 100.0);

    // SVG needs "339.29"; a bg-BG browser would format it as "339,29"
    private static string Css(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private sealed record Dimension(string Key, string Title, string Icon, string Color,
        Func<InnovationDraft?, (int? Score, string? Explanation)> Get);

    // Key + "Score" / Key + "Explanation" are the JSON field names
    private static readonly Dimension[] Dimensions =
    [
        new("originality", "Оригиналност", "lightbulb", "primary",
            d => (d?.OriginalityScore, d?.OriginalityExplanation)),
        new("technologicalInnovation", "Технологична иновация", "memory", "secondary",
            d => (d?.TechnologicalInnovationScore, d?.TechnologicalInnovationExplanation)),
        new("businessInnovation", "Бизнес модел", "business_center", "tertiary",
            d => (d?.BusinessInnovationScore, d?.BusinessInnovationExplanation)),
        new("growthPotential", "Потенциал за растеж", "trending_up", "primary",
            d => (d?.GrowthPotentialScore, d?.GrowthPotentialExplanation)),
    ];
}
