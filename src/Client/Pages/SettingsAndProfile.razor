@page "/settings-and-profile"
@layout AccountLayout
@attribute [Authorize]



    <!-- SideNavBar -->
    <nav class="hidden md:flex flex-col justify-between py-md fixed h-full left-0 w-sidebar-width border-r border-primary/10 flat no shadows bg-surface-container z-40">
        <div class="px-md flex flex-col gap-xl">
            <!-- Brand -->
            <div class="flex items-center gap-xs">
                <div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center border border-primary/40">
                    <span class="material-symbols-outlined text-primary" data-icon="memory">memory</span>
                </div>
                <div>
                    <h1 class="font-headline-md text-headline-md font-bold text-primary">InnovaFlow</h1>
                    <span class="font-data-mono text-data-mono text-on-surface-variant opacity-70">AI OS v2.4</span>
                </div>
            </div>
            <!-- Main Nav -->
            <ul class="flex flex-col gap-xs font-data-mono text-data-mono">
                <li>
                    <a class="flex items-center gap-sm px-sm py-xs rounded-DEFAULT text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-all" href="#">
                        <span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
                        Dashboard
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-sm px-sm py-xs rounded-DEFAULT text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-all" href="#">
                        <span class="material-symbols-outlined" data-icon="lightbulb">lightbulb</span>
                        My Ideas
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-sm px-sm py-xs rounded-DEFAULT text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-all" href="#">
                        <span class="material-symbols-outlined" data-icon="add_circle">add_circle</span>
                        Create Idea
                    </a>
                </li>
            </ul>
            <button class="w-full bg-primary text-surface font-bold py-sm rounded-DEFAULT glow-hover transition-all">
                Deploy Agent
            </button>
        </div>
        <!-- Footer Nav -->
        <ul class="flex flex-col gap-xs px-md font-data-mono text-data-mono">
            <li>
                <a class="flex items-center gap-sm px-sm py-xs rounded-DEFAULT bg-primary/10 text-primary border-l-4 border-primary transition-all" href="#">
                    <span class="material-symbols-outlined" data-icon="settings">settings</span>
                    Settings
                </a>
            </li>
            <li>
                <a class="flex items-center gap-sm px-sm py-xs rounded-DEFAULT text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-all" href="#">
                    <span class="material-symbols-outlined" data-icon="help">help</span>
                    Support
                </a>
            </li>
            <li>
                <a class="flex items-center gap-sm px-sm py-xs rounded-DEFAULT text-error hover:bg-error/10 hover:text-error transition-all" href="#">
                    <span class="material-symbols-outlined" data-icon="logout">logout</span>
                    Logout
                </a>
            </li>
        </ul>
    </nav>

        <!-- TopAppBar -->
        <header class="flex flex-col gap-sm p-md full-width border-b border-primary/20 shadow-lg shadow-primary/5 bg-surface-dim/50 backdrop-blur-xl sticky top-0 z-30">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-sm">
                    <span class="material-symbols-outlined text-primary text-3xl" data-icon="manage_accounts">manage_accounts</span>
                    <h1 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-primary">Настройки на профила</h1>
                </div>
                <div class="flex items-center gap-sm">
                    <button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded-lg transition-colors flex items-center justify-center">
                        <span class="material-symbols-outlined" data-icon="refresh">refresh</span>
                    </button>
                    <button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded-lg transition-colors flex items-center justify-center">
                        <span class="material-symbols-outlined" data-icon="ios_share">ios_share</span>
                    </button>
                </div>
            </div>
        </header>
        <!-- Settings Content Grid -->
        <div class="flex-1 p-md grid grid-cols-1 lg:grid-cols-12 gap-md max-w-container-max mx-auto w-full">
            <!-- Left Column: Profile & Avatar -->
            <div class="lg:col-span-8 flex flex-col gap-md">
                <!-- Profile Section -->
                <section class="bg-[#1E293B] border border-primary/10 rounded-xl p-md backdrop-blur-md glow-hover transition-all">
                    <h2 class="font-headline-md text-headline-md text-on-surface border-b border-primary/10 pb-sm mb-md flex items-center gap-xs">
                        <span class="material-symbols-outlined text-secondary" data-icon="person">person</span>
                        Лични Данни
                    </h2>
                    <div class="flex flex-col md:flex-row gap-md">
                        <!-- Avatar Uploader -->
                        <div class="flex-shrink-0 flex flex-col items-center gap-sm">
                            <div class="w-32 h-32 rounded-full border-2 border-primary/20 bg-surface-container overflow-hidden relative group cursor-pointer">
                                <img class="w-full h-full object-cover" data-alt="A highly detailed close-up of a futuristic cyberpunk avatar with glowing neon green highlights, sharp geometric features, and a dark, moody studio lighting setup, reflecting a high-end corporate AI aesthetic." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBLJcdUw-6mkjNdIxH7MRWGE-Hot1RbyWu-mU3THNtjRsNHi4KSAy6iozJ27Mom5opY91n9ttQ8hUJ8Le7oXmI4IOunRhy_0ydjnSmNmKE79l9HCWgLzmDQ3ozn03ZlUK7vEJYR7EyOS8QedmzsesvWZiAAbKm3ofEB24MIys3XAqC6ZufkHbZUV2u80bO1gjZgTc1eT7yDuzOlWu1aDVFS7GUKkQQaQ4g7xP5J6IxKWtJKkPHL9zGE" />
                                <div class="absolute inset-0 bg-surface/60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                    <span class="material-symbols-outlined text-primary" data-icon="photo_camera">photo_camera</span>
                                </div>
                            </div>
                            <span class="font-label-caps text-label-caps text-on-surface-variant uppercase">Смени Аватар</span>
                        </div>
                        <!-- Fields -->
                        <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-sm">
                            <div class="flex flex-col gap-xs">
                                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Име</label>
                                <input class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-body-md text-body-md text-on-surface w-full focus:border-primary transition-colors" type="text" value="Александър" />
                            </div>
                            <div class="flex flex-col gap-xs">
                                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Фамилия</label>
                                <input class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-body-md text-body-md text-on-surface w-full focus:border-primary transition-colors" type="text" value="Иванов" />
                            </div>
                            <div class="flex flex-col gap-xs md:col-span-2">
                                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Имейл</label>
                                <input class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-body-md text-body-md text-on-surface w-full focus:border-primary transition-colors" type="email" value="alexander.ivanov@innovation.studio" />
                            </div>
                            <div class="flex flex-col gap-xs md:col-span-2">
                                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Био (Терминален Вход)</label>
<textarea class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-data-mono text-data-mono text-secondary w-full focus:border-primary transition-colors resize-none" rows="3">&gt; Главен системен архитект. Фокус върху AI интеграции и квантови изчисления.</textarea>
                            </div>
                        </div>
                    </div>
                    <div class="mt-md flex justify-end">
                        <button class="bg-transparent border border-primary text-primary font-bold py-xs px-sm rounded-DEFAULT hover:bg-primary/10 transition-colors flex items-center gap-xs">
                            <span class="material-symbols-outlined text-sm" data-icon="save">save</span>
                            Запази Промените
                        </button>
                    </div>
                </section>
                <!-- Security Section -->
                <section class="bg-[#1E293B] border border-primary/10 rounded-xl p-md backdrop-blur-md glow-hover transition-all">
                    <h2 class="font-headline-md text-headline-md text-on-surface border-b border-primary/10 pb-sm mb-md flex items-center gap-xs">
                        <span class="material-symbols-outlined text-tertiary" data-icon="security">security</span>
                        Сигурност
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                        <!-- Password Change -->
                        <div class="flex flex-col gap-sm border-r-0 md:border-r border-primary/10 pr-0 md:pr-sm">
                            <div class="flex flex-col gap-xs">
                                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Текуща Парола</label>
                                <input class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-data-mono text-data-mono text-on-surface w-full focus:border-primary transition-colors" type="password" value="********" />
                            </div>
                            <div class="flex flex-col gap-xs">
                                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Нова Парола</label>
                                <input class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-data-mono text-data-mono text-on-surface w-full focus:border-primary transition-colors" type="password" />
                            </div>
                            <button class="self-start mt-xs text-secondary border border-secondary rounded-DEFAULT px-sm py-xs font-data-mono text-data-mono hover:bg-secondary/10 transition-colors">
                                Обнови Парола
                            </button>
                        </div>
                        <!-- 2FA -->
                        <div class="flex flex-col gap-sm pl-0 md:pl-sm justify-center">
                            <div class="flex items-center justify-between bg-surface-container/50 p-sm rounded-DEFAULT border border-primary/5">
                                <div class="flex flex-col">
                                    <span class="font-body-md text-body-md font-bold text-on-surface">Двуфакторна Автентикация (2FA)</span>
                                    <span class="font-data-mono text-data-mono text-on-surface-variant text-sm">Допълнително ниво на защита чрез криптографски токен.</span>
                                </div>
                                <!-- Custom Toggle -->
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input checked="" class="sr-only peer" type="checkbox" />
                                    <div class="w-11 h-6 bg-surface-container-high peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-on-surface after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                                </label>
                            </div>
                            <div class="flex items-center gap-xs text-primary bg-primary/5 p-xs rounded-DEFAULT">
                                <span class="material-symbols-outlined text-sm" data-icon="check_circle">check_circle</span>
                                <span class="font-data-mono text-data-mono text-sm">2FA е активна. Статус: Оптимално.</span>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
            <!-- Right Column: Notifications & Account Actions -->
            <div class="lg:col-span-4 flex flex-col gap-md">
                <!-- Notifications Panel -->
                <section class="bg-[#1E293B] border border-primary/10 rounded-xl p-md backdrop-blur-md glow-hover transition-all h-fit">
                    <h2 class="font-headline-md text-headline-md text-on-surface border-b border-primary/10 pb-sm mb-md flex items-center gap-xs">
                        <span class="material-symbols-outlined text-secondary-fixed-dim" data-icon="notifications">notifications</span>
                        Телеметрия
                    </h2>
                    <div class="flex flex-col gap-sm">
                        <!-- Toggle 1 -->
                        <div class="flex items-center justify-between py-xs border-b border-surface-container">
                            <span class="font-body-md text-body-md text-on-surface">Анализът е завършен</span>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input checked="" class="sr-only peer" type="checkbox" />
                                <div class="w-9 h-5 bg-surface-container-high rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-on-surface after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                            </label>
                        </div>
                        <!-- Toggle 2 -->
                        <div class="flex items-center justify-between py-xs border-b border-surface-container">
                            <span class="font-body-md text-body-md text-on-surface">Нова препоръка от AI</span>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input checked="" class="sr-only peer" type="checkbox" />
                                <div class="w-9 h-5 bg-surface-container-high rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-on-surface after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                            </label>
                        </div>
                        <!-- Toggle 3 -->
                        <div class="flex items-center justify-between py-xs border-b border-surface-container">
                            <span class="font-body-md text-body-md text-on-surface">Системни известия</span>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input class="sr-only peer" type="checkbox" />
                                <div class="w-9 h-5 bg-surface-container-high rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-on-surface after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                            </label>
                        </div>
                    </div>
                </section>
                <!-- Danger Zone -->
                <section class="bg-error/5 border border-error/20 rounded-xl p-md mt-auto">
                    <h3 class="font-body-md text-body-md font-bold text-error mb-xs">Опасна Зона</h3>
                    <p class="font-data-mono text-data-mono text-on-surface-variant text-sm mb-sm">Изход от текущата сесия. Всички незапазени локални данни ще бъдат изчистени от паметта.</p>
                    <button class="w-full bg-error/10 border border-error text-error hover:bg-error hover:text-on-error font-bold py-sm rounded-DEFAULT transition-colors flex items-center justify-center gap-xs">
                        <span class="material-symbols-outlined" data-icon="power_settings_new">power_settings_new</span>
                        Изход от Системата
                    </button>
                </section>
            </div>
        </div>
