
@page "/signin"
@inject AuthService Auth
@inject NavigationManager Navigation

@* Uses the default MainLayout (public shell). *@

<PageTitle>Влез в системата - InnovaFlow</PageTitle>

<HeadContent>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="css/login.css" />
</HeadContent>

<!-- BEGIN: MainContainer -->
@* Centred inside MainLayout's <main>, which is a flex column. *@
<div class="flex-grow flex items-center justify-center py-lg">
    <div
        class="w-full max-w-6xl font-sans text-gray-200 bg-brand-dark rounded-xl shadow-2xl overflow-hidden flex flex-col md:flex-row shadow-[0_0_50px_rgba(0,0,0,0.5)] border border-brand-border/50">
    <!-- BEGIN: LeftBrandingSide -->
    <section
        class="w-full md:w-1/2 bg-image-overlay p-10 flex flex-col justify-between relative min-h-[400px] md:min-h-[600px]">
        <!-- Top Content -->
        <div class="relative z-10">
            <!-- Logo -->
            <h1 class="text-5xl font-black text-primary tracking-tight glow-text mb-6">
                InnovaFlow
            </h1>
            <!-- Tagline -->
            <p class="text-2xl font-semibold text-white max-w-md leading-tight">
                Visions Realized through Neural Synthesis.
            </p>
        </div>
        <!-- Bottom Content / Status -->
        <div class="relative z-10 flex items-center text-sm font-mono text-primary/80 mt-12">
            <i class="fa-solid fa-microchip mr-2"></i>
            <span>System Status: <span class="text-white">Optimal</span></span>
        </div>
    </section>
    <!-- END: LeftBrandingSide -->

    <!-- BEGIN: RightLoginSide -->
    <section class="w-full md:w-1/2 bg-brand-navy p-10 md:p-14 flex flex-col justify-center">
        <!-- Header -->
        <header class="mb-10">
            <h2 class="text-3xl font-bold text-white mb-2">Влез в системата</h2>
            <p class="text-brand-textMuted text-sm">Enter your credentials to access the innovation cluster.</p>
        </header>

        <!-- Login Form -->
        <EditForm Model="model" OnValidSubmit="HandleSubmitAsync" FormName="signin" class="space-y-6">
            <DataAnnotationsValidator />

            <!-- Email Input -->
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-1 flex items-center" for="email">
                    <i class="fa-regular fa-envelope mr-2 text-primary text-xs"></i> Имейл
                </label>
                <div class="relative rounded-md shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-regular fa-envelope text-gray-500 sm:text-sm"></i>
                    </div>
                    <InputText @bind-Value="model.Email"
                        class="bg-brand-darkest border border-brand-border text-white text-sm rounded-md focus:ring-primary focus:border-primary block w-full pl-10 p-3"
                        id="email" placeholder="operator@neurallabs.ai" required type="email" autocomplete="email" />
                </div>
            </div>

            <!-- Password Input -->
            <div>
                <div class="flex justify-between items-center mb-1">
                    <label class="block text-sm font-medium text-gray-300 flex items-center" for="password">
                        <i class="fa-solid fa-lock mr-2 text-primary text-xs"></i> Парола
                    </label>
                    
                </div>
                <div class="relative rounded-md shadow-sm">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-key text-gray-500 sm:text-sm"></i>
                    </div>
                    <InputText @bind-Value="model.Password"
                        class="bg-brand-darkest border border-brand-border text-white text-sm rounded-md focus:ring-primary focus:border-primary block w-full pl-10 p-3"
                        id="password" placeholder="••••••••" required type="password" autocomplete="current-password" />
                </div>
            </div>

            @if (error is not null)
            {
                <p class="text-sm text-red-400" role="alert">@error</p>
            }

            <!-- Submit Button -->
            <div>
                <button disabled="@submitting"
                    class="w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-bold text-brand-darkest bg-primary hover:bg-primary-container focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors focus:ring-offset-brand-navy disabled:opacity-60"
                    type="submit">
                    ВХОД <i class="fa-solid fa-arrow-right-to-bracket ml-2"></i>
                </button>
            </div>
        </EditForm>

        <!-- Divider -->
        <div class="mt-8 relative">
            <div aria-hidden="true" class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-brand-border"></div>
            </div>
            <div class="relative flex justify-center text-xs font-mono">
                <span class="px-2 bg-brand-navy text-brand-textMuted uppercase tracking-widest">or authenticate via</span>
            </div>
        </div>

        <!-- Social Auth Buttons -->
        <div class="mt-8 grid grid-cols-2 gap-4">
            <!-- GitHub -->
            <button
                class="w-full inline-flex justify-center items-center py-2.5 px-4 border border-brand-border rounded-md shadow-sm bg-transparent text-sm font-medium text-gray-300 hover:bg-brand-border/30 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-border focus:ring-offset-brand-navy"
                type="button">
                <i class="fa-brands fa-github-alt mr-2 text-lg"></i>
                <span class="font-mono text-xs">GitHub Nexus</span>
            </button>
            <!-- Google Cloud -->
            <button
                class="w-full inline-flex justify-center items-center py-2.5 px-4 border border-brand-border rounded-md shadow-sm bg-transparent text-sm font-medium text-gray-300 hover:bg-brand-border/30 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-border focus:ring-offset-brand-navy"
                type="button">
                <i class="fa-brands fa-google mr-2 text-lg"></i>
                <span class="font-mono text-xs">Google Cloud</span>
            </button>
        </div>

        <!-- Footer Link -->
        <footer class="mt-8 text-center text-xs">
            <p class="text-brand-textMuted">
                Нямате активен възел?
                <a class="text-primary hover:underline font-medium" href="signup">Регистрация</a>
            </p>
        </footer>
    </section>
        <!-- END: RightLoginSide -->
    </div>
</div>
<!-- END: MainContainer -->

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private readonly LoginRequest model = new() { Email = "", Password = "" };
    private string? error;
    private bool submitting;

    private async Task HandleSubmitAsync()
    {
        submitting = true;
        error = null;

        var result = await Auth.SignInAsync(model);

        submitting = false;
        if (!result.Succeeded)
        {
            error = result.Error;
            return;
        }

        // only follow local return URLs
        var target = string.IsNullOrEmpty(ReturnUrl) || ReturnUrl.Contains("://") || ReturnUrl.StartsWith("//")
            ? "home"
            : ReturnUrl;
        Navigation.NavigateTo(target);
    }
}
