@page "/profile"
@layout AccountLayout
@attribute [Authorize]
@inject IdentityClient Auth
@inject NavigationManager Navigation

<PageTitle>Профил - InnovaFlow</PageTitle>



    

    
        <!-- Settings Content Grid -->
        <div class="flex-1 p-md grid grid-cols-1 lg:grid-cols-12 gap-md max-w-container-max mx-auto w-full">
            <!-- Left Column: Profile & Avatar -->
            <div class="lg:col-span-8 flex flex-col gap-md">
                <!-- Profile Section -->
                <section class="bg-[#1E293B] border border-primary/10 rounded-xl p-md backdrop-blur-md glow-hover transition-all">
                    <h2 class="font-headline-md text-headline-md text-on-surface border-b border-primary/10 pb-sm mb-md flex items-center gap-xs">
                        <span class="material-symbols-outlined text-secondary" data-icon="person">person</span>
                        Лични Данни
                    </h2>
                    @if (loading)
                    {
                        <p class="font-data-mono text-data-mono text-on-surface-variant">Зареждане на профила...</p>
                    }
                    else if (profile == null)
                    {
                        <div class="flex flex-col items-start gap-sm">
                            <p class="font-data-mono text-data-mono text-error" role="alert">Профилът не можа да бъде зареден.</p>
                            <button type="button" @onclick="LoadAsync"
                                    class="bg-transparent border border-primary text-primary font-bold py-xs px-sm rounded-DEFAULT hover:bg-primary/10 transition-colors">
                                Опитай отново
                            </button>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="profile">
                            <DataAnnotationsValidator />
                            <div class="flex flex-col md:flex-row gap-md">
                                <!-- Avatar -->
                                <div class="flex-shrink-0 flex flex-col items-center gap-sm">
                                    <div class="w-32 h-32 rounded-full border-2 border-primary/20 bg-surface-container overflow-hidden flex items-center justify-center">
                                        @if (!string.IsNullOrEmpty(profile.AvatarUrl))
                                        {
                                            <img class="w-full h-full object-cover" src="@profile.AvatarUrl" alt="Аватар" referrerpolicy="no-referrer" />
                                        }
                                        else
                                        {
                                            <span class="font-headline-md text-headline-md text-primary">@Initials</span>
                                        }
                                    </div>
                                </div>
                                <!-- Fields -->
                                <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-sm">
                                    <div class="flex flex-col gap-xs">
                                        <label for="first-name" class="font-label-caps text-label-caps text-on-surface-variant uppercase">Име</label>
                                        <InputText id="first-name" @bind-Value="model.FirstName" autocomplete="given-name"
                                                   class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-body-md text-body-md text-on-surface w-full focus:border-primary transition-colors" />
                                        <ValidationMessage For="() => model.FirstName" class="text-sm text-error" />
                                    </div>
                                    <div class="flex flex-col gap-xs">
                                        <label for="last-name" class="font-label-caps text-label-caps text-on-surface-variant uppercase">Фамилия</label>
                                        <InputText id="last-name" @bind-Value="model.LastName" autocomplete="family-name"
                                                   class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-body-md text-body-md text-on-surface w-full focus:border-primary transition-colors" />
                                        <ValidationMessage For="() => model.LastName" class="text-sm text-error" />
                                    </div>
                                    <div class="flex flex-col gap-xs md:col-span-2">
                                        <label for="email" class="font-label-caps text-label-caps text-on-surface-variant uppercase">Имейл</label>
                                        @* Read-only: the email is the sign-in name. *@
                                        <input id="email" type="email" value="@profile.Email" readonly
                                               class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-body-md text-body-md text-on-surface-variant w-full cursor-not-allowed" />
                                    </div>
                                    <div class="flex flex-col gap-xs md:col-span-2">
                                        <label for="bio" class="font-label-caps text-label-caps text-on-surface-variant uppercase">Био (Терминален Вход)</label>
                                        <InputTextArea id="bio" @bind-Value="model.Bio" rows="3" maxlength="2000"
                                                       class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-data-mono text-data-mono text-secondary w-full focus:border-primary transition-colors resize-none" />
                                        <ValidationMessage For="() => model.Bio" class="text-sm text-error" />
                                    </div>
                                </div>
                            </div>
                            <div class="mt-md flex items-center justify-end gap-sm">
                                @if (error != null)
                                {
                                    <span class="font-data-mono text-data-mono text-sm text-error" role="alert">@error</span>
                                }
                                else if (saved)
                                {
                                    <span class="font-data-mono text-data-mono text-sm text-primary flex items-center gap-xs" role="status">
                                        <span class="material-symbols-outlined text-sm">check_circle</span>
                                        Промените са запазени.
                                    </span>
                                }
                                <button type="submit" disabled="@saving"
                                        class="bg-transparent border border-primary text-primary font-bold py-xs px-sm rounded-DEFAULT hover:bg-primary/10 transition-colors flex items-center gap-xs disabled:opacity-60">
                                    <span class="material-symbols-outlined text-sm" data-icon="save">save</span>
                                    @(saving ? "Запазване..." : "Запази Промените")
                                </button>
                            </div>
                        </EditForm>
                    }
                </section>
                <!-- Security Section -->
                @* <section class="bg-[#1E293B] border border-primary/10 rounded-xl p-md backdrop-blur-md glow-hover transition-all">
                    <h2 class="font-headline-md text-headline-md text-on-surface border-b border-primary/10 pb-sm mb-md flex items-center gap-xs">
                        <span class="material-symbols-outlined text-tertiary" data-icon="security">security</span>
                        Сигурност
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                        <!-- Password Change -->
                        <div class="flex flex-col gap-sm border-r-0 md:border-r border-primary/10 pr-0 md:pr-sm">
                            <div class="flex flex-col gap-xs">
                                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Текуща Парола</label>
                                <input class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-data-mono text-data-mono text-on-surface w-full focus:border-primary transition-colors" type="password" value="********" />
                            </div>
                            <div class="flex flex-col gap-xs">
                                <label class="font-label-caps text-label-caps text-on-surface-variant uppercase">Нова Парола</label>
                                <input class="bg-[#0F172A] border border-primary/10 rounded-DEFAULT p-xs font-data-mono text-data-mono text-on-surface w-full focus:border-primary transition-colors" type="password" />
                            </div>
                            <button class="self-start mt-xs text-secondary border border-secondary rounded-DEFAULT px-sm py-xs font-data-mono text-data-mono hover:bg-secondary/10 transition-colors">
                                Обнови Парола
                            </button>
                        </div>
                        <!-- 2FA -->
                        <div class="flex flex-col gap-sm pl-0 md:pl-sm justify-center">
                            <div class="flex items-center justify-between bg-surface-container/50 p-sm rounded-DEFAULT border border-primary/5">
                                <div class="flex flex-col">
                                    <span class="font-body-md text-body-md font-bold text-on-surface">Двуфакторна Автентикация (2FA)</span>
                                    <span class="font-data-mono text-data-mono text-on-surface-variant text-sm">Допълнително ниво на защита чрез криптографски токен.</span>
                                </div>
                                <!-- Custom Toggle -->
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input checked="" class="sr-only peer" type="checkbox" />
                                    <div class="w-11 h-6 bg-surface-container-high peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-on-surface after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                                </label>
                            </div>
                            <div class="flex items-center gap-xs text-primary bg-primary/5 p-xs rounded-DEFAULT">
                                <span class="material-symbols-outlined text-sm" data-icon="check_circle">check_circle</span>
                                <span class="font-data-mono text-data-mono text-sm">2FA е активна. Статус: Оптимално.</span>
                            </div>
                        </div>
                    </div>
                </section> *@
            </div>
            <!-- Right Column: Notifications & Account Actions -->
            <div class="lg:col-span-4 flex flex-col gap-md">
                <!-- Notifications Panel -->
                @* <section class="bg-[#1E293B] border border-primary/10 rounded-xl p-md backdrop-blur-md glow-hover transition-all h-fit">
                    <h2 class="font-headline-md text-headline-md text-on-surface border-b border-primary/10 pb-sm mb-md flex items-center gap-xs">
                        <span class="material-symbols-outlined text-secondary-fixed-dim" data-icon="notifications">notifications</span>
                        Телеметрия
                    </h2>
                    <div class="flex flex-col gap-sm">
                        <!-- Toggle 1 -->
                        <div class="flex items-center justify-between py-xs border-b border-surface-container">
                            <span class="font-body-md text-body-md text-on-surface">Анализът е завършен</span>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input checked="" class="sr-only peer" type="checkbox" />
                                <div class="w-9 h-5 bg-surface-container-high rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-on-surface after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                            </label>
                        </div>
                        <!-- Toggle 2 -->
                        <div class="flex items-center justify-between py-xs border-b border-surface-container">
                            <span class="font-body-md text-body-md text-on-surface">Нова препоръка от AI</span>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input checked="" class="sr-only peer" type="checkbox" />
                                <div class="w-9 h-5 bg-surface-container-high rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-on-surface after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                            </label>
                        </div>
                        <!-- Toggle 3 -->
                        <div class="flex items-center justify-between py-xs border-b border-surface-container">
                            <span class="font-body-md text-body-md text-on-surface">Системни известия</span>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input class="sr-only peer" type="checkbox" />
                                <div class="w-9 h-5 bg-surface-container-high rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-on-surface after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"></div>
                            </label>
                        </div>
                    </div>
                </section> *@
                <!-- Danger Zone -->
                <section class="bg-error/5 border border-error/20 rounded-xl p-md mt-auto">
                    <h3 class="font-body-md text-body-md font-bold text-error mb-xs">Опасна Зона</h3>
                    <button type="button" @onclick="SignOutAsync" class="w-full bg-error/10 border border-error text-error hover:bg-error hover:text-on-error font-bold py-sm rounded-DEFAULT transition-colors flex items-center justify-center gap-xs">
                        <span class="material-symbols-outlined" data-icon="power_settings_new">power_settings_new</span>
                        Изход от Системата
                    </button>
                </section>
            </div>
        </div>

@code {
    private ProfileResponse? profile;
    private UpdateProfileRequest model = new();
    private bool loading = true;
    private bool saving;
    private bool saved;
    private string? error;

    private string Initials
    {
        get
        {
            var letters = new[] { profile?.FirstName, profile?.LastName }
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Select(n => char.ToUpper(n!.Trim()[0]));
            var text = string.Concat(letters);
            return text.Length > 0 ? text : char.ToUpper(profile?.Email.FirstOrDefault() ?? '?').ToString();
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        profile = await Auth.GetProfileAsync();
        if (profile != null)
            model = new UpdateProfileRequest { FirstName = profile.FirstName, LastName = profile.LastName, Bio = profile.Bio };
        loading = false;
    }

    private async Task SaveAsync()
    {
        saving = true;
        saved = false;
        error = null;

        var (updated, err) = await Auth.UpdateProfileAsync(model);

        saving = false;
        if (updated == null)
        {
            error = err ?? "Възникна грешка. Опитайте отново.";
            return;
        }

        profile = updated;
        saved = true;
    }

    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("signin");
    }
}
