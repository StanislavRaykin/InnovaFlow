<!DOCTYPE html>
<html class="dark" lang="bg">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>InnovaFlow - Създаване на Идея</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet"/>
   <link rel="stylesheet" href="~/css/createidea_css.css"  />
<script src="~/js/createidea3&4_js.js"></script>
</head>

<body class="font-body-md text-body-md antialiased min-h-screen flex flex-col md:flex-row overflow-x-hidden">
    <!-- TopNavBar (Mobile Only) -->
    <nav class="md:hidden fixed top-0 left-0 w-full z-50 flex justify-between items-center px-md h-16 bg-surface/80 backdrop-blur-md border-b border-primary/10">
        <div class="flex items-center gap-sm">
            <span class="material-symbols-outlined text-primary">lightbulb</span>
            <span class="font-headline-md font-bold text-primary">InnovaFlow</span>
        </div>
        <button class="text-on-surface-variant hover:text-primary transition-colors">
            <span class="material-symbols-outlined">menu</span>
        </button>
    </nav>

    <!-- SideNavBar (Desktop) -->
    <aside class="hidden md:flex flex-col justify-between py-md fixed h-full left-0 w-sidebar-width bg-surface-container border-r border-primary/10 z-40">
        <div>
            <div class="px-md mb-xl">
                <div class="flex items-center gap-sm mb-xs">
                    <span class="material-symbols-outlined text-primary text-3xl" style="font-variation-settings: 'FILL' 1;">lightbulb</span>
                    <span class="font-headline-md text-2xl font-bold text-primary">InnovaFlow</span>
                </div>
                <div class="font-data-mono text-xs text-primary/70">AI OS v2.4</div>
            </div>
            <nav class="flex flex-col gap-xs px-sm font-data-mono text-sm">
                <a class="flex items-center gap-sm px-sm py-2 rounded text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors" href="#">
                    <span class="material-symbols-outlined text-xl">dashboard</span>
                    Dashboard
                </a>
                <a class="flex items-center gap-sm px-sm py-2 rounded text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors" href="#">
                    <span class="material-symbols-outlined text-xl">lightbulb</span>
                    My Ideas
                </a>
                <a class="flex items-center gap-sm px-sm py-2 rounded bg-primary/10 text-primary border-l-4 border-primary transition-colors" href="#">
                    <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">add_circle</span>
                    Create Idea
                </a>
            </nav>
        </div>
        <div class="px-sm font-data-mono text-sm">
            <button class="w-full py-2 mb-md bg-primary-container text-surface font-label-caps font-bold rounded hover:opacity-90 transition-opacity">
                Deploy Agent
            </button>
            <nav class="flex flex-col gap-xs">
                <a class="flex items-center gap-sm px-sm py-2 rounded text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors" href="#">
                    <span class="material-symbols-outlined text-xl">settings</span>
                    Settings
                </a>
                <a class="flex items-center gap-sm px-sm py-2 rounded text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors" href="#">
                    <span class="material-symbols-outlined text-xl">help</span>
                    Support
                </a>
                <a class="flex items-center gap-sm px-sm py-2 rounded text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors" href="#">
                    <span class="material-symbols-outlined text-xl">logout</span>
                    Logout
                </a>
            </nav>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 mt-16 md:mt-0 md:ml-sidebar-width flex flex-col min-h-screen">
        <!-- TopAppBar -->
        <header class="flex flex-col gap-sm p-md bg-surface-dim/70 backdrop-blur-xl border-b border-primary/20 shadow-lg shadow-primary/5 z-30 sticky top-0 md:top-0">
            <div class="flex justify-between items-center">
                <div class="flex items-center gap-sm">
                    <span class="material-symbols-outlined text-primary text-2xl">analytics</span>
                    <h1 class="font-headline-lg text-2xl md:text-3xl font-bold text-primary">Idea Analysis</h1>
                </div>
                <div class="flex gap-sm">
                    <button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded transition-colors">
                        <span class="material-symbols-outlined">refresh</span>
                    </button>
                    <button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded transition-colors">
                        <span class="material-symbols-outlined">ios_share</span>
                    </button>
                </div>
            </div>

            <!-- Progress Indicator -->
            <div class="mt-xs">
                <div class="flex justify-between mb-1.5 font-data-mono text-xs">
                    <span class="text-on-surface-variant">01 Idea</span>
                    <span class="text-on-surface-variant">02 Problem</span>
                    <span class="text-primary font-bold">03 Audience</span>
                    <span class="text-on-surface-variant">04 Review</span>
                </div>
                <div class="w-full h-1 bg-surface-container rounded-full overflow-hidden flex">
                    <div class="w-1/4 bg-primary/40"></div>
                    <div class="w-1/4 bg-primary/40"></div>
                    <div class="w-1/4 bg-primary shimmer-progress"></div>
                    <div class="w-1/4 bg-surface-container-highest/30"></div>
                </div>
            </div>
        </header>

        <!-- Canvas / Content -->
        <div class="flex-1 p-md md:p-lg flex flex-col justify-center items-center">
            <div class="w-full max-w-5xl grid grid-cols-1 lg:grid-cols-12 gap-md items-start">
                
                <!-- Step 3: Input Form (Left Column) -->
                <section class="lg:col-span-5 glass-panel rounded-xl p-md flex flex-col gap-md cyber-glow relative overflow-hidden">
                    <div class="border-b border-primary/10 pb-sm">
                        <span class="font-label-caps text-xs text-secondary tracking-wider block mb-1">СТЪПКА 03</span>
                        <h2 class="font-headline-md text-xl font-bold text-on-surface">Целева Аудитория</h2>
                        <p class="font-body-md text-sm text-on-surface-variant mt-1">За кого е предназначена вашата идея?</p>
                    </div>

                    <div class="flex flex-col gap-xs">
                        <label class="font-label-caps text-xs text-on-surface-variant uppercase tracking-wider">Индустрия</label>
                        <div class="relative group">
                            <select class="w-full bg-surface-container-low border border-outline-variant rounded p-sm text-on-surface font-body-md text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all appearance-none cursor-pointer">
                                <option class="bg-surface-container text-on-surface">Технологии / Носими устройства (Wearables)</option>
                                <option class="bg-surface-container text-on-surface">Здравеопазване и фитнес</option>
                                <option class="bg-surface-container text-on-surface">Финанси и финтех</option>
                                <option class="bg-surface-container text-on-surface">Образование и развитие</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">expand_more</span>
                        </div>
                    </div>

                    <div class="flex flex-col gap-xs">
                        <label class="font-label-caps text-xs text-on-surface-variant uppercase tracking-wider">Описание на аудиторията</label>
                        <div class="relative group">
                            <textarea rows="5" class="w-full bg-surface-container-low border border-outline-variant rounded p-sm text-on-surface font-body-md text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all resize-none shadow-inner placeholder-on-surface-variant/50" placeholder="Опишете демографията, поведението и нуждите на вашите идеални клиенти...">Активни професионалисти на възраст 25-45, които търсят дискретен начин да следят здравословното си състояние и нотификации по време на срещи, без да се разсейват със смартфони.</textarea>
                        </div>
                    </div>

                    <div class="flex justify-between items-center pt-xs border-t border-primary/10 mt-xs">
                        <button class="px-md py-sm rounded border border-primary/30 text-primary font-label-caps text-xs font-bold hover:bg-primary/5 transition-colors">
                            Назад
                        </button>
                        <span class="font-data-mono text-xs text-on-surface-variant">2 от 4 попълнени</span>
                    </div>
                </section>

                <!-- Step 4: System Review Summary (Right Column) -->
                <section class="lg:col-span-7 glass-panel rounded-xl p-md flex flex-col relative overflow-hidden cyber-glow">
                    <!-- Subtle background glow -->
                    <div class="absolute -top-12 -right-12 w-40 h-40 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>
                    <div class="absolute -bottom-12 -left-12 w-40 h-40 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

                    <div class="border-b border-primary/10 pb-sm mb-md relative z-10 flex justify-between items-end">
                        <div>
                            <span class="font-label-caps text-xs text-secondary bg-secondary/10 px-2 py-1 rounded border border-secondary/20 inline-block mb-1">ПРЕГЛЕД НА ДАННИТЕ</span>
                            <h2 class="font-headline-md text-xl font-bold text-on-surface">Системно Резюме</h2>
                        </div>
                        <span class="font-data-mono text-xs text-primary flex items-center gap-xs bg-primary/10 px-2.5 py-1 rounded border border-primary/20">
                            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                            Готовност: 85%
                        </span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-sm relative z-10 mb-md">
                        <!-- Card 1 -->
                        <div class="glass-subcard p-sm rounded transition-all">
                            <span class="font-label-caps text-xs text-on-surface-variant block mb-1">ИМЕ НА ИДЕЯТА</span>
                            <span class="font-data-mono text-primary font-bold text-base">SmartWear</span>
                        </div>
                        <!-- Card 2 -->
                        <div class="glass-subcard p-sm rounded transition-all">
                            <span class="font-label-caps text-xs text-on-surface-variant block mb-1">ТИП</span>
                            <span class="font-data-mono text-on-surface text-sm">Хардуерен Продукт (B2C)</span>
                        </div>
                        <!-- Card 3 -->
                        <div class="glass-subcard p-sm rounded sm:col-span-2 transition-all">
                            <span class="font-label-caps text-xs text-on-surface-variant block mb-1">ИНДУСТРИЯ</span>
                            <span class="font-data-mono text-secondary text-sm">Технологии / Носими устройства (Wearables)</span>
                        </div>
                        <!-- Card 4 -->
                        <div class="glass-subcard p-sm rounded sm:col-span-2 transition-all">
                            <span class="font-label-caps text-xs text-on-surface-variant block mb-1 flex items-center gap-xs">
                                <span class="material-symbols-outlined text-sm text-secondary">description</span> КРАТКО ОПИСАНИЕ
                            </span>
                            <p class="font-body-md text-sm text-on-surface-variant leading-relaxed">Интелигентен пръстен, който интегрира биометрични сензори и хаптична обратна връзка за дискретни нотификации.</p>
                        </div>
                        <!-- Card 5 -->
                        <div class="glass-subcard p-sm rounded sm:col-span-2 transition-all">
                            <span class="font-label-caps text-xs text-on-surface-variant block mb-1 flex items-center gap-xs">
                                <span class="material-symbols-outlined text-sm text-tertiary">warning</span> ИДЕНТИФИЦИРАН ПРОБЛЕМ
                            </span>
                            <p class="font-body-md text-sm text-on-surface-variant leading-relaxed">Смартчасовниците са твърде натрапчиви по време на бизнес срещи, а смартфоните отвличат вниманието. Липсва дискретен начин за филтриране на важни известия.</p>
                        </div>
                    </div>

                    <!-- Action Area -->
                    <div class="mt-auto relative z-10 pt-sm border-t border-primary/10">
                        <p class="font-data-mono text-xs text-on-surface-variant/80 mb-sm text-center flex items-center justify-center gap-1">
                            <span class="material-symbols-outlined text-sm text-secondary">memory</span>
                            AI ще анализира вашата идея относно пазарен потенциал, иновация и рискове.
                        </p>
                        <button class="w-full bg-primary-container text-surface font-label-caps text-sm font-bold py-3 rounded neon-glow-btn flex justify-center items-center gap-sm hover:opacity-95">
                            <span class="material-symbols-outlined text-base">auto_awesome</span>
                            Анализирай Идеята
                            <span class="material-symbols-outlined text-base">arrow_forward</span>
                        </button>
                    </div>
                </section>

            </div>
        </div>

        <!-- Footer -->
        <footer class="flex justify-between items-center px-md py-sm bg-surface-container-lowest border-t border-primary/10 mt-auto">
            <div class="font-label-caps text-xs text-primary">© 2024 Innovation Studio. AI OS v2.4</div>
            <div class="flex gap-md font-label-caps text-xs text-on-surface-variant">
                <a class="hover:text-secondary-fixed-dim transition-colors flex items-center gap-xs" href="#">
                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse cyber-glow"></span>
                    System Status: Optimal
                </a>
                <a class="hover:text-secondary-fixed-dim transition-colors hidden md:block" href="#">Privacy Policy</a>
                <a class="hover:text-secondary-fixed-dim transition-colors hidden md:block" href="#">API Docs</a>
            </div>
        </footer>
    </main>
</body>
</html>