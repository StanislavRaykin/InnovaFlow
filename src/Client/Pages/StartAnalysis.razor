@page "/start-analysis"
@layout AccountLayout
@attribute [Authorize]
@* for logged in users *@



<!-- TopAppBar (Hidden Navigation Context - Linear/Transactional Override applied to TopNavBar) -->
<header
    class="flex flex-col gap-sm p-md bg-surface-dim/50 backdrop-blur-xl border-b border-primary/20 shadow-lg shadow-primary/5 sticky top-0 z-30">
    <div class="flex justify-between items-center">
        <div class="flex items-center gap-sm">
            <span class="material-symbols-outlined text-primary text-3xl" data-icon="analytics"
                  style="font-variation-settings: 'FILL' 1;">analytics</span>
            <h1
                class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-primary">
                Анализ на Идеята</h1>
            </div>
            <div class="flex gap-sm">
                <button
                    class="p-xs text-on-surface-variant hover:bg-primary/10 rounded-lg transition-colors group relative">
                    <span class="material-symbols-outlined group-hover:text-primary" data-icon="refresh">refresh</span>
                </button>
                <button
                    class="p-xs text-on-surface-variant hover:bg-primary/10 rounded-lg transition-colors group relative">
                    <span class="material-symbols-outlined group-hover:text-primary" data-icon="ios_share">ios_share</span>
                </button>
            </div>
        </div>
    </header>
    <!-- Main Body -->
    <div class="flex-1 p-md md:p-xl flex flex-col items-center justify-center relative">
        <!-- Central Processing UI -->
        <div class="w-full max-w-4xl grid grid-cols-1 lg:grid-cols-2 gap-md items-start">
            <!-- Left Column: Status & Progress -->
            <div
                class="flex flex-col gap-lg bg-surface-container/80 backdrop-blur-xl border border-primary/10 rounded-xl p-md md:p-xl shadow-[0_0_15px_rgba(74,222,128,0.05)]">
                <div class="text-center lg:text-left">
                    <h2 class="font-display-lg text-display-lg text-primary mb-xs">Анализиране...</h2>
                    <p class="font-body-lg text-body-lg text-on-surface-variant">Нашите AI агенти оценяват вашата идея
                        от множество перспективи в реално време.</p>
                    </div>
                    <!-- Progress Section -->
                    <div class="space-y-sm">
                        <div class="flex justify-between font-data-mono text-data-mono text-secondary">
                            <span>ПРОГРЕС НА АНАЛИЗА</span>
                            <span>6 / 8 МОДУЛА</span>
                        </div>
                        <div class="w-full h-1 bg-surface-container-highest rounded-full overflow-hidden">
                            <div class="h-full bg-primary shimmer-bar w-3/4 shadow-[0_0_10px_rgba(74,222,128,0.5)]"></div>
                        </div>
                    </div>
                    <!-- Process List -->
                    <div class="space-y-sm font-data-mono text-data-mono mt-sm">
                        <div class="flex items-center gap-sm text-on-surface-variant opacity-70">
                            <span class="material-symbols-outlined text-primary" data-icon="check_circle"
                                  style="font-variation-settings: 'FILL' 1;">check_circle</span>
                            <span>Разбиране на вашата идея</span>
                        </div>
                        <div class="flex items-center gap-sm text-on-surface-variant opacity-70">
                            <span class="material-symbols-outlined text-primary" data-icon="check_circle"
                                  style="font-variation-settings: 'FILL' 1;">check_circle</span>
                            <span>Идентифициране на целева аудитория</span>
                        </div>
                        <div class="flex items-center gap-sm text-on-surface-variant opacity-70">
                            <span class="material-symbols-outlined text-primary" data-icon="check_circle"
                                  style="font-variation-settings: 'FILL' 1;">check_circle</span>
                            <span>Анализ на пазара</span>
                        </div>
                        <div class="flex items-center gap-sm text-on-surface-variant opacity-70">
                            <span class="material-symbols-outlined text-primary" data-icon="check_circle"
                                  style="font-variation-settings: 'FILL' 1;">check_circle</span>
                            <span>Намиране на конкуренти</span>
                        </div>
                        <!-- Active Step -->
                        <div
                            class="flex items-center gap-sm text-primary font-bold p-xs rounded-DEFAULT bg-primary/5 border border-primary/20">
                            <span class="material-symbols-outlined text-primary animate-pulse-glow rounded-full"
                                  data-icon="pending">pending</span>
                            <span>Оценяване на иновацията</span>
                            <span
                            class="ml-auto text-label-caps font-label-caps text-secondary-fixed-dim animate-pulse">ОБРАБОТКА...</span>
                        </div>
                        <div class="flex items-center gap-sm text-surface-bright">
                            <span class="material-symbols-outlined"
                                  data-icon="radio_button_unchecked">radio_button_unchecked</span>
                            <span>Оценка на осъществимостта</span>
                        </div>
                        <div class="flex items-center gap-sm text-surface-bright">
                            <span class="material-symbols-outlined"
                                  data-icon="radio_button_unchecked">radio_button_unchecked</span>
                            <span>Идентифициране на рискове</span>
                        </div>
                        <div class="flex items-center gap-sm text-surface-bright">
                            <span class="material-symbols-outlined"
                                  data-icon="radio_button_unchecked">radio_button_unchecked</span>
                            <span>Генериране на препоръки</span>
                        </div>
                    </div>
                </div>
                <!-- Right Column: AI Agent Swarm -->
                <div
                    class="flex flex-col gap-md bg-surface-container-low/50 backdrop-blur-xl border border-primary/10 rounded-xl p-md relative overflow-hidden h-full min-h-[400px]">
                    <!-- Subtle background decoration -->
                    <div class="absolute inset-0 opacity-10 flex items-center justify-center pointer-events-none">
                        <span class="material-symbols-outlined text-[200px] text-primary" data-icon="memory">memory</span>
                    </div>
                    <h3 class="font-label-caps text-label-caps text-on-surface-variant mb-xs z-10">АКТИВНИ AI АГЕНТИ</h3>
                    <div class="grid grid-cols-2 gap-sm z-10 flex-1 content-start">
                        <!-- Agent 1: Completed -->
                        <div class="bg-surface-container border border-primary/10 rounded-lg p-sm flex items-center gap-sm">
                            <div class="w-8 h-8 rounded-full bg-surface-variant flex items-center justify-center">
                                <span class="material-symbols-outlined text-sm text-primary"
                                      data-icon="trending_up">trending_up</span>
                            </div>
                            <div>
                                <div class="font-label-caps text-label-caps text-primary">Market Agent</div>
                                <div class="font-data-mono text-[10px] text-on-surface-variant">ПРИКЛЮЧЕН</div>
                            </div>
                        </div>
                        <!-- Agent 2: Active (Innovation) -->
                        <div
                            class="bg-surface-container border border-primary/40 rounded-lg p-sm flex items-center gap-sm agent-active relative overflow-hidden">
                            <div class="absolute inset-0 bg-primary/5"></div>
                            <div
                                class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center border border-primary relative z-10">
                                <span class="material-symbols-outlined text-sm text-primary"
                                      data-icon="tips_and_updates">tips_and_updates</span>
                            </div>
                            <div class="relative z-10">
                                <div class="font-label-caps text-label-caps text-primary shadow-primary">Innovation Agent
                                </div>
                                <div class="font-data-mono text-[10px] text-secondary">СКАНИРАНЕ...</div>
                            </div>
                        </div>
                        <!-- Agent 3: Completed -->
                        <div class="bg-surface-container border border-primary/10 rounded-lg p-sm flex items-center gap-sm">
                            <div class="w-8 h-8 rounded-full bg-surface-variant flex items-center justify-center">
                                <span class="material-symbols-outlined text-sm text-primary" data-icon="groups">groups</span>
                            </div>
                            <div>
                                <div class="font-label-caps text-label-caps text-primary">Audience Agent</div>
                                <div class="font-data-mono text-[10px] text-on-surface-variant">ПРИКЛЮЧЕН</div>
                            </div>
                        </div>
                        <!-- Agent 4: Pending -->
                        <div
                            class="bg-surface-container border border-surface-bright rounded-lg p-sm flex items-center gap-sm opacity-50">
                            <div class="w-8 h-8 rounded-full bg-surface-bright flex items-center justify-center">
                                <span class="material-symbols-outlined text-sm text-on-surface-variant"
                                      data-icon="construction">construction</span>
                            </div>
                            <div>
                                <div class="font-label-caps text-label-caps text-on-surface-variant">Feasibility Agent</div>
                                <div class="font-data-mono text-[10px] text-surface-bright">ИЗЧАКВАНЕ</div>
                            </div>
                        </div>
                        <!-- Agent 5: Pending -->
                        <div
                            class="bg-surface-container border border-surface-bright rounded-lg p-sm flex items-center gap-sm opacity-50">
                            <div class="w-8 h-8 rounded-full bg-surface-bright flex items-center justify-center">
                                <span class="material-symbols-outlined text-sm text-on-surface-variant"
                                      data-icon="warning">warning</span>
                            </div>
                            <div>
                                <div class="font-label-caps text-label-caps text-on-surface-variant">Risk Agent</div>
                                <div class="font-data-mono text-[10px] text-surface-bright">ИЗЧАКВАНЕ</div>
                            </div>
                        </div>
                    </div>
                    <!-- Network Visualizer Output Box -->
                    <div
                        class="mt-auto bg-[#040812] border border-primary/20 rounded-DEFAULT p-sm font-data-mono text-[10px] text-secondary-fixed-dim z-10 h-24 overflow-hidden relative">
                        <div class="absolute inset-0 bg-gradient-to-b from-transparent to-[#040812] z-10 pointer-events-none">
                        </div>
                        <div class="space-y-1 opacity-80" id="terminal-output">
                            <div>&gt; Инициализиране на модул 'Иновации'... OK</div>
                            <div>&gt; Зареждане на патентни бази данни... OK</div>
                            <div>&gt; Търсене на семантични съвпадения...</div>
                            <div class="text-primary">&gt; Открити 3 потенциални вектора за диференциация.</div>
                            <div>&gt; Изчисляване на индекс на уникалност...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>