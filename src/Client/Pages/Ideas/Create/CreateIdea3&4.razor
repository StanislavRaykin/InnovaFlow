@page "/ideas/create/review"
@layout AccountLayout
@attribute [Authorize]
@inject IdeaDraft Draft
@inject DraftAutosave Autosave
@inject IdeaClient Ideas
@inject AnalysisClient Analyses
@inject NavigationManager Navigation
@implements IAsyncDisposable

@* Steps 03 Audience / 04 Review of the create-idea wizard — the continuation of
   /ideas/create (CreateIdea1&2.razor, next to this file).

   The side nav, the mobile top bar and the footer now live in AccountLayout, as
   does the css/createidea.css link behind .glass-panel, .glass-subcard,
   .cyber-glow, .neon-glow-btn and .shimmer-progress. The TopAppBar stays here
   because it marks step 03 as the current one.

   The old ~/js/createidea3&4_js.js was only another copy of the Tailwind config,
   which index.html already loads from js/tailwind.config.js — so it is gone. *@

<PageTitle>InnovaFlow - Създаване на Идея</PageTitle>

<!-- TopAppBar -->
<header
    class="flex flex-col gap-sm p-md bg-surface-dim/70 backdrop-blur-xl border-b border-primary/20 shadow-lg shadow-primary/5 z-30 sticky top-16 md:top-0">
    <div class="flex justify-between items-center">
        <div class="flex items-center gap-sm">
            <span class="material-symbols-outlined text-primary text-2xl">analytics</span>
            <h1 class="font-headline-lg text-2xl md:text-3xl font-bold text-primary">Idea Analysis</h1>
        </div>
        <div class="flex gap-sm">
            <button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded transition-colors">
                <span class="material-symbols-outlined">refresh</span>
            </button>
            <button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded transition-colors">
                <span class="material-symbols-outlined">ios_share</span>
            </button>
        </div>
    </div>

    <!-- Progress Indicator -->
    <div class="mt-xs">
        <div class="flex justify-between mb-1.5 font-data-mono text-xs">
            <span class="text-on-surface-variant">01 Idea</span>
            <span class="text-on-surface-variant">02 Problem</span>
            <span class="text-primary font-bold">03 Audience</span>
            <span class="text-on-surface-variant">04 Review</span>
        </div>
        <div class="w-full h-1 bg-surface-container rounded-full overflow-hidden flex">
            <div class="w-1/4 bg-primary/40"></div>
            <div class="w-1/4 bg-primary/40"></div>
            <div class="w-1/4 bg-primary shimmer-progress"></div>
            <div class="w-1/4 bg-surface-container-highest/30"></div>
        </div>
    </div>
</header>

<!-- Canvas / Content -->
<div class="flex-1 p-md md:p-lg flex flex-col justify-center items-center">
    <div class="w-full max-w-5xl grid grid-cols-1 lg:grid-cols-12 gap-md items-start">

        <!-- Step 3: Input Form (Left Column) -->
        <section class="lg:col-span-5 glass-panel rounded-xl p-md flex flex-col gap-md cyber-glow relative overflow-hidden">
            <div class="border-b border-primary/10 pb-sm">
                <span class="font-label-caps text-xs text-secondary tracking-wider block mb-1">СТЪПКА 03</span>
                <h2 class="font-headline-md text-xl font-bold text-on-surface">Целева Аудитория</h2>
                <p class="font-body-md text-sm text-on-surface-variant mt-1">За кого е предназначена вашата идея?</p>
            </div>

            <div class="flex flex-col gap-xs">
                <label class="font-label-caps text-xs text-on-surface-variant uppercase tracking-wider">Индустрия</label>
                <div class="relative group">
                    <select class="w-full bg-surface-container-low border border-outline-variant rounded p-sm text-on-surface font-body-md text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all appearance-none cursor-pointer" @bind="Draft.Industry">
                        @foreach (var industry in IdeaDraft.Industries)
                        {
                            <option class="bg-surface-container text-on-surface" value="@industry">@industry</option>
                        }
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">expand_more</span>
                </div>
            </div>

            <div class="flex flex-col gap-xs">
                <label class="font-label-caps text-xs text-on-surface-variant uppercase tracking-wider">Описание на аудиторията</label>
                <div class="relative group">
                    <textarea rows="5" class="w-full bg-surface-container-low border border-outline-variant rounded p-sm text-on-surface font-body-md text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/50 transition-all resize-none shadow-inner placeholder-on-surface-variant/50" placeholder="Опишете демографията, поведението и нуждите на вашите идеални клиенти..." @bind="Draft.Audience" @bind:event="oninput"></textarea>
                </div>
            </div>

            <div class="flex justify-between items-center pt-xs border-t border-primary/10 mt-xs">
                <a class="px-md py-sm rounded border border-primary/30 text-primary font-label-caps text-xs font-bold hover:bg-primary/5 transition-colors"
                   href="ideas/create">
                    Назад
                </a>
                <span class="font-data-mono text-xs text-on-surface-variant">2 от 4 попълнени</span>
            </div>
        </section>

        <!-- Step 4: System Review Summary (Right Column) -->
        <section class="lg:col-span-7 glass-panel rounded-xl p-md flex flex-col relative overflow-hidden cyber-glow">
            <!-- Subtle background glow -->
            <div class="absolute -top-12 -right-12 w-40 h-40 bg-secondary/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-12 -left-12 w-40 h-40 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="border-b border-primary/10 pb-sm mb-md relative z-10 flex justify-between items-end">
                <div>
                    <span class="font-label-caps text-xs text-secondary bg-secondary/10 px-2 py-1 rounded border border-secondary/20 inline-block mb-1">ПРЕГЛЕД НА ДАННИТЕ</span>
                    <h2 class="font-headline-md text-xl font-bold text-on-surface">Системно Резюме</h2>
                </div>
                @* <span class="font-data-mono text-xs text-primary flex items-center gap-xs bg-primary/10 px-2.5 py-1 rounded border border-primary/20">
                    <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                    Готовност: 85%
                </span> *@
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-sm relative z-10 mb-md">
                <!-- Card 1 -->
                <div class="glass-subcard p-sm rounded transition-all">
                    <span class="font-label-caps text-xs text-on-surface-variant block mb-1">ИМЕ НА ИДЕЯТА</span>
                    <span class="font-data-mono text-primary font-bold text-base">@Show(Draft.Name)</span>
                </div>
                <!-- Card 2 -->
                <div class="glass-subcard p-sm rounded transition-all">
                    <span class="font-label-caps text-xs text-on-surface-variant block mb-1">ТИП</span>
                    <span class="font-data-mono text-on-surface text-sm">@Draft.Type</span>
                </div>
                <!-- Card 3 -->
                <div class="glass-subcard p-sm rounded sm:col-span-2 transition-all">
                    <span class="font-label-caps text-xs text-on-surface-variant block mb-1">ИНДУСТРИЯ</span>
                    <span class="font-data-mono text-secondary text-sm">@Draft.Industry</span>
                </div>
                <!-- Card 4 -->
                <div class="glass-subcard p-sm rounded sm:col-span-2 transition-all">
                    <span class="font-label-caps text-xs text-on-surface-variant block mb-1 flex items-center gap-xs">
                        <span class="material-symbols-outlined text-sm text-secondary">description</span> ЦЕЛЕВА АУДИТОРИЯ
                    </span>
                    <p class="font-body-md text-sm text-on-surface-variant leading-relaxed">@Show(Draft.Audience)</p>
                </div>
                <!-- Card 5 -->
                <div class="glass-subcard p-sm rounded sm:col-span-2 transition-all">
                    <span class="font-label-caps text-xs text-on-surface-variant block mb-1 flex items-center gap-xs">
                        <span class="material-symbols-outlined text-sm text-tertiary">warning</span> ИДЕНТИФИЦИРАН ПРОБЛЕМ
                    </span>
                    <p class="font-body-md text-sm text-on-surface-variant leading-relaxed">@Show(Draft.Problem)</p>
                </div>
                <!-- Card 6 -->
                <div class="glass-subcard p-sm rounded sm:col-span-2 transition-all">
                    <span class="font-label-caps text-xs text-on-surface-variant block mb-1 flex items-center gap-xs">
                        <span class="material-symbols-outlined text-sm text-tertiary">description</span> ОПИСАНИЕ НА ИДЕЯТА
                    </span>
                    <p class="font-body-md text-sm text-on-surface-variant leading-relaxed">@Show(Draft.Description)</p>
                </div>
                </div>
            </div>

            <!-- Action Area -->
            <div class="mt-auto relative z-10 pt-sm border-t border-primary/10">
                <p class="font-data-mono text-xs text-on-surface-variant/80 mb-sm text-center flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-sm text-secondary">memory</span>
                    AI ще анализира вашата идея относно пазарен потенциал, иновация и рискове.
                </p>
                @if (error != null)
                {
                    <p class="font-body-md text-sm text-error mb-sm text-center">@error</p>
                }
                <button class="w-full bg-primary-container text-surface font-label-caps text-sm font-bold py-3 rounded neon-glow-btn flex justify-center items-center gap-sm hover:opacity-95 disabled:opacity-50 disabled:cursor-wait" disabled="@submitting" @onclick="OnAnalyzeSubmit">
                    <span class="material-symbols-outlined text-base">auto_awesome</span>
                    @(submitting ? "Стартиране..." : "Анализирай Идеята")
                    <span class="material-symbols-outlined text-base">arrow_forward</span>
                </button>
            </div>
        </section>

    </div>
</div>

@code {
    private bool submitting;
    private string? error;

    // set once the idea is created, so a retry after a failed analysis start
    // doesn't try to create it a second time
    private Guid? createdIdeaId;

    protected override void OnInitialized()
    {

      Autosave.Start();
    }


    public async ValueTask DisposeAsync() => await Autosave.StopAsync();

    private static string Show(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private async Task OnAnalyzeSubmit()
    {
        if (submitting)
            return;

        submitting = true;
        error = null;
        try
        {
            if (createdIdeaId == null)
            {
                var created = await Ideas.CreateIdeaAsync();
                if (!created.Success)
                {
                    error = created.Error;
                    return;
                }
                createdIdeaId = created.IdeaId;
            }

            var started = await Analyses.StartAnalysisAsync(createdIdeaId.Value);
            if (!started.Success)
            {
                error = started.Error;
                return;
            }

            await Autosave.ResetAsync();
            Navigation.NavigateTo($"start-analysis/{started.AnalysisId}");
        }
        finally
        {
            submitting = false;
        }
    }
}
