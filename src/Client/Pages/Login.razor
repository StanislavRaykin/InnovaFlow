<!DOCTYPE html>

<html lang="bg"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Влез в системата - InnovaFlow</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet"/>
<link rel="stylesheet" href="~/css/login_css.css"  />
<script src="~/js/login_js.js"></script>
</head>

<body class="min-h-screen flex items-center justify-center p-4 font-sans text-gray-200">
<!-- BEGIN: MainContainer -->
<main class="w-full max-w-6xl bg-brand-dark rounded-xl shadow-2xl overflow-hidden flex flex-col md:flex-row shadow-[0_0_50px_rgba(0,0,0,0.5)] border border-brand-border/50">
<!-- BEGIN: LeftBrandingSide -->
<section class="w-full md:w-1/2 bg-image-overlay p-10 flex flex-col justify-between relative min-h-[400px] md:min-h-[600px]">
<!-- Top Content -->
<div class="relative z-10">
<!-- Logo -->
<h1 class="text-5xl font-black text-brand-mint tracking-tight glow-text mb-6">
          InnovaFlow
        </h1>
<!-- Tagline -->
<p class="text-2xl font-semibold text-white max-w-md leading-tight">
          Visions Realized through Neural Synthesis.
        </p>
</div>
<!-- Bottom Content / Status -->
<div class="relative z-10 flex items-center text-sm font-mono text-brand-mint/80 mt-12">
<i class="fa-solid fa-microchip mr-2"></i>
<span>System Status: <span class="text-white">Optimal</span></span>
</div>
</section>
<!-- END: LeftBrandingSide -->
<!-- BEGIN: RightLoginSide -->
<section class="w-full md:w-1/2 bg-brand-navy p-10 md:p-14 flex flex-col justify-center">
<!-- Header -->
<header class="mb-10">
<h2 class="text-3xl font-bold text-white mb-2">Влез в системата</h2>
<p class="text-brand-textMuted text-sm">Enter your credentials to access the innovation cluster.</p>
</header>
<!-- Login Form -->
<form action="#" class="space-y-6" method="POST">
<!-- Email Input -->
<div>
<label class="block text-sm font-medium text-gray-300 mb-1 flex items-center" for="email">
<i class="fa-regular fa-envelope mr-2 text-brand-mint text-xs"></i> Имейл
          </label>
<div class="relative rounded-md shadow-sm">
<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
<i class="fa-regular fa-envelope text-gray-500 sm:text-sm"></i>
</div>
<input class="bg-brand-darkest border border-brand-border text-white text-sm rounded-md focus:ring-brand-mint focus:border-brand-mint block w-full pl-10 p-3" id="email" name="email" placeholder="operator@neurallabs.ai" required="" type="email"/>
</div>
</div>
<!-- Password Input -->
<div>
<div class="flex justify-between items-center mb-1">
<label class="block text-sm font-medium text-gray-300 flex items-center" for="password">
<i class="fa-solid fa-lock mr-2 text-brand-mint text-xs"></i> Парола
            </label>
<a class="text-xs font-mono text-brand-mint hover:text-brand-mintDark transition-colors" href="#">Decrypt Key?</a>
</div>
<div class="relative rounded-md shadow-sm">
<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
<i class="fa-solid fa-key text-gray-500 sm:text-sm"></i>
</div>
<input class="bg-brand-darkest border border-brand-border text-white text-sm rounded-md focus:ring-brand-mint focus:border-brand-mint block w-full pl-10 p-3" id="password" name="password" placeholder="••••••••" required="" type="password"/>
</div>
</div>
<!-- Submit Button -->
<div>
<button class="w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-bold text-brand-darkest bg-brand-mint hover:bg-brand-mintDark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-mint transition-colors focus:ring-offset-brand-navy" type="submit">
            ВХОД <i class="fa-solid fa-arrow-right-to-bracket ml-2"></i>
</button>
</div>
</form>
<!-- Divider -->
<div class="mt-8 relative">
<div aria-hidden="true" class="absolute inset-0 flex items-center">
<div class="w-full border-t border-brand-border"></div>
</div>
<div class="relative flex justify-center text-xs font-mono">
<span class="px-2 bg-brand-navy text-brand-textMuted uppercase tracking-widest">or authenticate via</span>
</div>
</div>
<!-- Social Auth Buttons -->
<div class="mt-8 grid grid-cols-2 gap-4">
<!-- GitHub -->
<button class="w-full inline-flex justify-center items-center py-2.5 px-4 border border-brand-border rounded-md shadow-sm bg-transparent text-sm font-medium text-gray-300 hover:bg-brand-border/30 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-border focus:ring-offset-brand-navy" type="button">
<i class="fa-brands fa-github-alt mr-2 text-lg"></i>
<span class="font-mono text-xs">GitHub Nexus</span>
</button>
<!-- Google Cloud -->
<button class="w-full inline-flex justify-center items-center py-2.5 px-4 border border-brand-border rounded-md shadow-sm bg-transparent text-sm font-medium text-gray-300 hover:bg-brand-border/30 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-border focus:ring-offset-brand-navy" type="button">
<i class="fa-brands fa-google mr-2 text-lg"></i>
<span class="font-mono text-xs">Google Cloud</span>
</button>
</div>
</section>
<!-- END: RightLoginSide -->
</main>
<!-- END: MainContainer -->
</body></html>