</head>

<body class="font-body-md text-body-md antialiased min-h-screen flex flex-col md:flex-row">
<!-- TopNavBar (Mobile Only) -->
<nav class="md:hidden bg-surface/80 backdrop-blur-md fixed top-0 left-0 w-full z-50 flex justify-between items-center px-md h-16 border-b border-primary/10 flat no shadows">
<div class="font-headline-md text-headline-md font-bold text-primary">InnovaFlow</div>
<div class="flex items-center gap-sm">
<span class="material-symbols-outlined text-primary cursor-pointer">menu</span>
</div>
</nav>
<!-- SideNavBar (Desktop Only) -->
<aside class="hidden md:flex flex-col justify-between py-md bg-surface-container fixed h-full left-0 w-sidebar-width border-r border-primary/10 flat no shadows z-40">
<div>
<div class="px-md mb-xl">
<h1 class="font-headline-md text-headline-md font-bold text-primary flex items-center gap-xs">
<span class="material-symbols-outlined" data-icon="lightbulb" style="font-variation-settings: 'FILL' 1;">lightbulb</span>
                    InnovaFlow
                </h1>
<p class="font-data-mono text-data-mono text-on-surface-variant mt-xs">AI OS v2.4</p>
</div>
<nav class="flex flex-col gap-xs px-sm font-data-mono text-data-mono">
<a class="flex items-center gap-sm px-sm py-xs text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors rounded-DEFAULT" href="#">
<span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
                    Dashboard
                </a>
<a class="flex items-center gap-sm px-sm py-xs text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors rounded-DEFAULT" href="#">
<span class="material-symbols-outlined" data-icon="lightbulb">lightbulb</span>
                    My Ideas
                </a>
<a class="flex items-center gap-sm px-sm py-xs bg-primary/10 text-primary border-l-4 border-primary glow-active transition-colors rounded-r-DEFAULT" href="#">
<span class="material-symbols-outlined" data-icon="add_circle" style="font-variation-settings: 'FILL' 1;">add_circle</span>
                    Create Idea
                </a>
</nav>
</div>
<div class="px-sm font-data-mono text-data-mono">
<button class="w-full mb-md py-xs bg-surface-variant text-on-surface border border-primary/20 rounded-DEFAULT hover:border-primary/50 transition-colors flex justify-center items-center gap-xs">
                Deploy Agent
            </button>
<nav class="flex flex-col gap-xs">
<a class="flex items-center gap-sm px-sm py-xs text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors rounded-DEFAULT" href="#">
<span class="material-symbols-outlined" data-icon="settings">settings</span>
                    Settings
                </a>
<a class="flex items-center gap-sm px-sm py-xs text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors rounded-DEFAULT" href="#">
<span class="material-symbols-outlined" data-icon="help">help</span>
                    Support
                </a>
<a class="flex items-center gap-sm px-sm py-xs text-on-surface-variant hover:bg-surface-variant/50 hover:text-on-surface transition-colors rounded-DEFAULT" href="#">
<span class="material-symbols-outlined" data-icon="logout">logout</span>
                    Logout
                </a>
</nav>
</div>
</aside>
<!-- Main Content Area -->
<main class="flex-1 md:ml-sidebar-width pt-16 md:pt-0 flex flex-col min-h-screen">
<!-- TopAppBar -->
<header class="bg-surface-dim/50 backdrop-blur-xl border-b border-primary/20 shadow-lg shadow-primary/5 full-width flex flex-col gap-sm p-md z-30 sticky top-0 md:top-0">
<div class="flex justify-between items-center">
<div class="flex items-center gap-sm">
<span class="material-symbols-outlined text-primary text-[32px]" data-icon="analytics">analytics</span>
<h2 class="font-headline-lg text-headline-lg md:font-headline-lg md:text-headline-lg font-bold text-primary">Създаване на Идея</h2>
</div>
<div class="flex gap-sm">
<button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded-lg transition-colors flex items-center justify-center">
<span class="material-symbols-outlined" data-icon="refresh">refresh</span>
</button>
<button class="p-xs text-on-surface-variant hover:bg-primary/10 rounded-lg transition-colors flex items-center justify-center">
<span class="material-symbols-outlined" data-icon="ios_share">ios_share</span>
</button>
</div>
</div>
<!-- Progress Bar -->
<div class="mt-sm">
<div class="flex justify-between font-data-mono text-data-mono mb-xs text-on-surface-variant">
<span>Стъпка 1: Основи</span>
<span>Стъпка 2: Проблем</span>
<span class="text-primary font-bold">Стъпка 3: Аудитория</span>
<span>Стъпка 4: Преглед</span>
</div>
<div class="h-1 bg-surface-container-high rounded-full overflow-hidden flex">
<div class="w-1/4 bg-primary/40 border-r border-surface"></div>
<div class="w-1/4 bg-primary/40 border-r border-surface"></div>
<div class="w-1/4 bg-primary shimmer-progress"></div>
<div class="w-1/4 bg-transparent"></div>
</div>
</div>
</header>
<!-- Canvas -->
<div class="flex-1 p-md lg:p-lg overflow-y-auto">
<div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-md">
<!-- Step 3: Input Form (Left Column on Desktop) -->
<section class="lg:col-span-5 glass-panel rounded-xl p-md flex flex-col gap-md">
<div class="border-b border-primary/10 pb-sm mb-xs">
<h3 class="font-headline-md text-headline-md text-primary">Целева Аудитория</h3>
<p class="font-body-md text-body-md text-on-surface-variant mt-xs">За кого е предназначена вашата идея?</p>
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-caps text-label-caps text-on-surface-variant">ИНДУСТРИЯ</label>
<div class="relative">
<select class="w-full bg-[#0F172A] border border-outline-variant rounded-DEFAULT py-sm px-sm text-on-surface focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none appearance-none transition-colors">
<option>Технологии / Носими устройства (Wearables)</option>
<option>Здравеопазване</option>
<option>Финанси</option>
<option>Образование</option>
</select>
<span class="material-symbols-outlined absolute right-sm top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none">expand_more</span>
</div>
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-caps text-label-caps text-on-surface-variant">ОПИСАНИЕ НА АУДИТОРИЯТА</label>
<textarea class="w-full bg-[#0F172A] border border-outline-variant rounded-DEFAULT py-sm px-sm text-on-surface focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition-colors resize-none placeholder:text-on-surface-variant/50" placeholder="Опишете демографията, поведението и нуждите на вашите идеални клиенти..." rows="4">Активни професионалисти на възраст 25-45, които търсят дискретен начин да следят здравословното си състояние и нотификации по време на срещи, без да се разсейват със смартфони.</textarea>
</div>
</section>
<!-- Step 4: Review Summary (Right Column on Desktop) -->
<section class="lg:col-span-7 glass-panel rounded-xl p-md flex flex-col relative overflow-hidden">
<!-- Subtle background grid/glow for the summary card -->
<div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent pointer-events-none"></div>
<div class="border-b border-primary/10 pb-sm mb-md relative z-10 flex justify-between items-end">
<div>
<span class="font-label-caps text-label-caps text-secondary bg-secondary/10 px-xs py-1 rounded-sm border border-secondary/20 inline-block mb-xs">ПРЕГЛЕД НА ДАННИТЕ</span>
<h3 class="font-headline-md text-headline-md text-on-surface">Системно Резюме</h3>
</div>
<span class="font-data-mono text-data-mono text-on-surface-variant flex items-center gap-xs">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                            Готовност: 85%
                        </span>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-sm relative z-10 mb-md">
<!-- Data Points Bento Layout -->
<div class="bg-surface/50 border border-primary/10 p-sm rounded-lg hover:border-secondary/30 transition-colors">
<span class="font-label-caps text-label-caps text-on-surface-variant block mb-1">ИМЕ НА ИДЕЯТА</span>
<span class="font-data-mono text-data-mono text-primary text-lg">SmartWear</span>
</div>
<div class="bg-surface/50 border border-primary/10 p-sm rounded-lg hover:border-secondary/30 transition-colors">
<span class="font-label-caps text-label-caps text-on-surface-variant block mb-1">ТИП</span>
<span class="font-data-mono text-data-mono text-on-surface">Хардуерен Продукт (B2C)</span>
</div>
<div class="bg-surface/50 border border-primary/10 p-sm rounded-lg sm:col-span-2 hover:border-secondary/30 transition-colors">
<span class="font-label-caps text-label-caps text-on-surface-variant block mb-1">ИНДУСТРИЯ</span>
<span class="font-data-mono text-data-mono text-on-surface">Технологии / Носими устройства (Wearables)</span>
</div>
<div class="bg-surface/50 border border-primary/10 p-sm rounded-lg sm:col-span-2 hover:border-secondary/30 transition-colors">
<span class="font-label-caps text-label-caps text-on-surface-variant block mb-1 flex items-center gap-xs">
<span class="material-symbols-outlined text-[16px]">description</span> КРАТКО ОПИСАНИЕ
                            </span>
<p class="font-body-md text-body-md text-on-surface-variant">Интелигентен пръстен, който интегрира биометрични сензори и хаптична обратна връзка за дискретни нотификации.</p>
</div>
<div class="bg-surface/50 border border-primary/10 p-sm rounded-lg sm:col-span-2 hover:border-secondary/30 transition-colors">
<span class="font-label-caps text-label-caps text-on-surface-variant block mb-1 flex items-center gap-xs">
<span class="material-symbols-outlined text-[16px]">warning</span> ИДЕНТИФИЦИРАН ПРОБЛЕМ
                            </span>
<p class="font-body-md text-body-md text-on-surface-variant">Смартчасовниците са твърде натрапчиви по време на бизнес срещи, а смартфоните отвличат вниманието. Липсва дискретен начин за филтриране на важни известия.</p>
</div>
</div>
<!-- Action Area -->
<div class="mt-auto relative z-10 pt-sm border-t border-primary/10">
<p class="font-data-mono text-[12px] text-on-surface-variant mb-md text-center">
<span class="material-symbols-outlined text-[14px] align-middle mr-1 text-secondary">memory</span>
                            AI ще анализира вашата идея относно пазарен потенциал, иновация, аудитория, осъществимост и рискове.
                        </p>
<button class="w-full bg-primary-container text-on-primary-container font-headline-md text-[18px] py-sm rounded-DEFAULT neon-glow-btn flex justify-center items-center gap-sm">
                            ✨ Анализирай Идеята
                        </button>
</div>
</section>
</div>
</div>
<!-- Footer -->
<footer class="bg-surface-container-lowest full-width py-sm border-t border-primary/10 flat no shadows flex justify-between items-center px-md mt-auto">
<div class="font-label-caps text-primary">© 2024 Innovation Studio. AI OS v2.4</div>
<div class="flex gap-md font-label-caps text-label-caps">
<a class="text-on-surface-variant hover:text-secondary-fixed-dim flex items-center gap-xs" href="#">
<span class="w-2 h-2 rounded-full bg-primary shadow-[0_0_8px_#4ADE80] animate-pulse"></span>
                    System Status: Optimal
                </a>
<a class="text-on-surface-variant hover:text-secondary-fixed-dim hidden sm:inline-block" href="#">Privacy Policy</a>
<a class="text-on-surface-variant hover:text-secondary-fixed-dim hidden sm:inline-block" href="#">API Docs</a>
</div>
</footer>
</main>
</body></html>